#!/usr/bin/python3 -I
"""phonecam-develop RAW W H STRIDE OUT.jpg [--frames N] [--rot DEG] [--bayer GRBG|RGGB|BGGR|GBRG]
                 [--ccm s5kjn1|none] [--sat F] [--black N] [--zoom Z] [--size LONG_EDGE]
                 [--meter X,Y] [--matrix 12 floats] [--wb RGAIN,BGAIN] [--ev STOPS] [--gain F]
                 [--aspect RATIO] [--dng OUT.dng] [--exif EXPOSURE_US,ISO]

--zoom crops the centre, --size scales the result to that long edge, --meter exposes for the point
(0..1, sensor orientation), --matrix is a 3x4 row-major colour filter on 0..1 sRGB RGB (offset last).
--wb fixes the white balance (default: grey world), --ev brightens by stops, --gain replaces the
automatic exposure gain (1: sensor clipping is white), --aspect crops to long/short edge RATIO,
--dng also writes the stacked Bayer data before any processing, --exif tags the files.

Develops 10-bit CSI-2 packed frames (N back to back in RAW) into a JPEG:
align + sum frames, defect pixel fix, black level, white balance, demosaic,
colour matrix, noise-adaptive denoise, tone curve, sharpening, rotation.
Works in row bands on all cores; prints progress 0..1 per line on stdout.
Needs its kernels built next to it: cc -O3 -march=native -shared -fPIC phonecam-fast.c -o phonecam-fast.so
"""
import ctypes
import os
import sys
import time
from concurrent.futures import ThreadPoolExecutor
import numpy as np
import cv2

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import phonecamlib as lib

# s5kjn1 colour matrices from libcamera's softisp tuning (ct, 3x3 cam RGB -> sRGB)
CCMS = {
    2867: [[1.95177, -0.35904, -0.59274], [-0.44282, 1.97362, -0.53079], [-0.49059, -1.35379, 2.84439]],
    3761: [[2.29903, -0.94652, -0.35251], [-0.51661, 1.90311, -0.38651], [-0.25114, -0.67501, 1.92615]],
    6890: [[1.93867, -0.67486, -0.26381], [-0.43049, 2.00702, -0.57652], [-0.15696, -0.51345, 1.67041]],
}
WHITE = 1023
PED = 8192  # pedestal kept under the signal until after demosaic, see develop()
BAND = 64  # rows per work item, small enough to stay in cache; multiple of 8
cv2.setNumThreads(1)  # parallelism comes from the bands
POOL = ThreadPoolExecutor(os.cpu_count() or 4)
C = ctypes.CDLL(os.path.join(os.path.dirname(os.path.realpath(__file__)), "phonecam-fast.so"))
P, I, F = ctypes.c_void_p, ctypes.c_int, ctypes.c_float
C.stack_rows.argtypes = [P, I, P, P, I, I, I, I, I, I, I, P]
C.fix_rows.argtypes = [P, I, I, ctypes.c_uint, I, I, P]
C.quads.argtypes = [P, I, I, F, I, I, P]
C.wb_rows.argtypes = [P, I, I, I, P, P, P, P]
C.ccm_luma.argtypes = [P, ctypes.c_size_t, P, P, P]


def ptr(a):
    return a.ctypes.data


def par(fn, h):
    """fn(y0, y1) over row bands of h, on all cores."""
    return list(POOL.map(lambda y: fn(y, min(y + BAND, h)), range(0, h, BAND)))


class Raw:
    """Packed RAW10 frames in a file, cropped by (dy, dx) so the pattern starts as GRBG."""

    def __init__(self, path, w, h, stride, n, dy, dx, zoom=1.0):
        size = stride * h
        self.data = np.memmap(path, np.uint8, "r")
        self.n = min(n, len(self.data) // size)
        if self.n < 1:
            sys.exit(f"phonecam-develop: {path} is shorter than one frame")
        self.ptrs = (ctypes.c_void_p * self.n)(*(ptr(self.data) + i * size for i in range(self.n)))
        self.stride, self.dy, self.dx, self.w, self.h = stride, dy, dx, w - 2, h - 2
        if zoom > 1:  # centre crop, offsets even so the Bayer phase holds
            cw, ch = int(self.w / zoom) // 4 * 4, int(self.h / zoom) // 4 * 4
            self.dx, self.dy = dx + (self.w - cw) // 4 * 2, dy + (self.h - ch) // 4 * 2
            self.w, self.h = cw, ch

    def rows(self, y0, y1, shifts=((0, 0, 0),), out=None):
        """rows y0..y1 (cropped) of the sum over (i, sx, sy) of frame i read at (x + sx, y + sy)."""
        out = np.empty((y1 - y0, self.w), np.uint16) if out is None else out
        ptrs = (ctypes.c_void_p * len(shifts))(*(self.ptrs[i] for i, _, _ in shifts))
        sx = (ctypes.c_int * len(shifts))(*(s[1] for s in shifts))
        sy = (ctypes.c_int * len(shifts))(*(s[2] for s in shifts))
        C.stack_rows(ptrs, len(shifts), sx, sy, self.w, self.h, self.stride, self.dx, self.dy, y0, y1, ptr(out))
        return out


def stack(src, log):
    """Sum of frames after undoing global hand shake (uint16, at most 64 frames), defects fixed;
    shifts are kept even so the Bayer phase holds; where a shifted frame has no data the first frame stands in."""
    w, h = src.w, src.h
    shifts = [(0, 0, 0)]
    if src.n > 1:
        # a centre crop at most 1024x768 at 1/(4f) scale: a bigger FFT costs more than it aligns better;
        # 50 MP bins 2x more so dim scenes still correlate
        f = max(1, w // 4096)
        cw, ch = min(w // (16 * f), 256) * 16 * f, min(h // (16 * f), 192) * 16 * f
        cx, cy = (w - cw) // 4 * 2, (h - ch) // 4 * 2
        prox = np.empty((src.n, ch // 4, cw // 4), np.float32)

        def proxies(y0, y1):
            q = np.empty(((y1 - y0) // 4, cw // 4, 3), np.float32)
            for i in range(src.n):
                b = np.ascontiguousarray(src.rows(y0, y1, ((i, 0, 0),))[:, cx:cx + cw])
                C.quads(ptr(b), cw, 1, 0, 0, y1 - y0, ptr(q))
                prox[i, (y0 - cy) // 4:(y1 - cy) // 4] = q[:, :, 1]
        list(POOL.map(lambda y: proxies(y, min(y + BAND, cy + ch)), range(cy, cy + ch, BAND)))
        if f > 1:
            prox = np.stack([cv2.resize(p, (cw // 4 // f, ch // 4 // f), interpolation=cv2.INTER_AREA) for p in prox])
        win = cv2.createHanningWindow(prox.shape[:0:-1], cv2.CV_32F)
        for i, ((dx, dy), resp) in enumerate(POOL.map(lambda p: cv2.phaseCorrelate(prox[0], p, win), prox[1:]), 1):
            sx, sy = int(round(dx * 2 * f)) * 2, int(round(dy * 2 * f)) * 2  # proxy px = 4f raw px
            if resp < 0.05 or max(abs(sx), abs(sy)) > w // 10:
                log(f"frame skipped: shift {sx},{sy} resp {resp:.2f}")
            else:
                shifts.append((i, sx, sy))
    log(f"stacked {len(shifts)}/{src.n} frames")
    acc = np.empty((h, w), np.uint16)
    par(lambda y0, y1: src.rows(y0, y1, shifts, acc[y0:y1]), h)
    fx = np.empty_like(acc)
    # hot, dead and stuck pixels: far from the median of their 3x3 same-colour neighbours
    par(lambda y0, y1: C.fix_rows(ptr(acc), w, h, 40 * len(shifts), y0, y1, ptr(fx)), h)
    return fx, len(shifts)


def grey_world(q, black):
    """WB gains from block means (q: RGB at 1/4 scale, black removed) that are neither near black
    nor clipped. Blocks, not pixels: a per-pixel threshold on noisy data biases toward bright green noise."""
    r, g, b = cv2.split(cv2.resize(q, None, fx=0.25, fy=0.25, interpolation=cv2.INTER_AREA))
    top = (WHITE - black) * 0.9
    ok = ((g + r + b) / 3 > 2) & (np.maximum(np.maximum(g, r), b) < top)
    if ok.sum() < 100:
        return 1.0, 1.0
    gm = g[ok].sum()
    return gm / max(r[ok].sum(), 1e-3), gm / max(b[ok].sum(), 1e-3)


def pick_ccm(rg, bg):
    """Rough colour temperature from WB gains: warm light needs big blue gain."""
    ratio = bg / rg
    ct = 2867 if ratio > 1.6 else 3761 if ratio > 1.0 else 6890
    return np.array(CCMS[ct], np.float32), ct


def tone_curve(x):
    """Linear 0..1 (times exposure gain) -> 8-bit sRGB with a soft shoulder."""
    x = np.clip(x * 1.15 / (1 + 0.15 * x), 0, 1)  # soft shoulder, 1 stays 1
    s = np.where(x <= 0.0031308, 12.92 * x, 1.055 * np.power(x, 1 / 2.4) - 0.055)
    return np.clip(s * 255 + 0.5, 0, 255).astype(np.uint8)


def tone_lut(gain):
    """16-bit with pedestal -> 8-bit sRGB."""
    return tone_curve(np.maximum(np.arange(65536, dtype=np.float32) - PED, 0) / (65535 - PED) * gain)


def noise_sigma(y):
    """Luma noise estimate from a flat-ish high-pass (MAD of a 3x3 residual)."""
    s = y[::4, ::4].astype(np.float32)
    r = s - cv2.blur(s, (3, 3))
    return 1.4826 * float(np.median(np.abs(r - np.median(r)))) * 1.06


def develop(src, black=64, rot=0, ccm_name="s5kjn1", sat=1.0, log=print, progress=lambda f: None,
            meter=None, matrix=None, size=0, wb=None, ev=0.0, fixed_gain=None, aspect=0.0, dng=None, exif=None, anon=False):
    acc, n = stack(src, log)
    src.data = None  # unmap the raw file
    h, w = acc.shape
    progress(0.25)

    # 1/4 scale RGB from the 2x2 quads, for white balance, exposure and chroma
    q = np.empty((h // 4, w // 4, 3), np.float32)

    par(lambda y0, y1: C.quads(ptr(acc), w, n, black, y0, y1, ptr(q)), h // 4 * 4)
    rg, bg = wb or grey_world(q, black)
    if ccm_name == "s5kjn1":
        ccm, ct = pick_ccm(rg, bg)
    else:
        ccm, ct = np.eye(3, dtype=np.float32), 0
    log(f"wb r={rg:.3f} b={bg:.3f} ccm ct={ct} kelvin={lib.gains_kelvin(rg, bg):.0f}")
    if dng:  # the stack as shot: sum of n frames, so black and white scale with n
        lib.write_dng(dng, w, h, acc.data, black * n, WHITE * n, (rg, bg),
                      CCMS[6890] if ccm_name == "s5kjn1" else np.eye(3).tolist(), rot=rot,
                      exp_us=exif[0] if exif else 0, iso=exif[1] if exif else 0, anon=anon)
    progress(0.4)

    # Noise around black must not be clipped before demosaic: R and B carry more of it after WB,
    # so clipping lifts them more than G and dark scenes turn magenta. Keep a pedestal instead.
    k = (65535.0 - PED) / (WHITE - black)
    v = np.arange(n * WHITE + 1, dtype=np.float32) / n - black
    lut16 = [np.clip(v * g * k + PED, 0, 65535).astype(np.uint16) for g in (1.0, rg, bg)]  # G, R, B
    m = ccm[::-1, ::-1]  # ccm is RGB, OpenCV is BGR
    mat = np.hstack([m, PED * (1 - m.sum(1, keepdims=True))]).astype(np.float32)

    # colour and exposure from the small image, the same chain as full size without its clipping of noise
    small = np.clip(q[:, :, ::-1] * np.float32([bg, 1, rg]) * k + PED, 0, 65535)
    small = np.clip(cv2.transform(small, mat), 0, 65535)
    small = np.maximum(small - PED, 0) / (65535 - PED)
    del q
    y = cv2.cvtColor(small.astype(np.float32), cv2.COLOR_BGR2GRAY)
    gain = min(0.75 / max(float(np.percentile(y, 97)), 1 / 1024), 12.0)
    if meter:  # the tapped spot goes to mid grey; the rest may clip
        r = max(4, min(y.shape) // 16)
        cx, cy = int(meter[0] * y.shape[1]), int(meter[1] * y.shape[0])
        spot = float(y[max(cy - r, 0):cy + r, max(cx - r, 0):cx + r].mean())
        gain = float(np.clip(0.2 / max(spot, 1e-4), gain / 4, min(gain * 4, 16.0)))
    if fixed_gain:
        gain = fixed_gain
    gain *= 2.0 ** ev
    tlut = tone_lut(gain)

    yy = np.empty((h, w), np.uint8)

    def luma(y0, y1):
        m0, m1 = max(y0 - 4, 0), min(y1 + 4, h)
        r16 = np.empty((m1 - m0, w), np.uint16)
        C.wb_rows(ptr(acc), w, m0, m1, *map(ptr, lut16), ptr(r16))
        bgr = np.ascontiguousarray(cv2.cvtColor(r16, cv2.COLOR_BayerGB2BGR_EA)[y0 - m0:y1 - m0])
        C.ccm_luma(ptr(bgr), bgr.shape[0] * w, ptr(mat), ptr(tlut), ptr(yy[y0:y1]))
    par(luma, h)
    del acc
    progress(0.7)

    sigma = noise_sigma(yy)
    log(f"tone gain {gain:.2f} luma noise {sigma:.1f}")
    if matrix is not None:  # filter: 3x4 on RGB 0..1 -> BGR on 0..255
        fm = np.asarray(matrix, np.float32).reshape(3, 4)
        fm = np.hstack([fm[::-1, 2::-1], fm[::-1, 3:] * 255])
    _, cr, cb = cv2.split(cv2.cvtColor(tone_curve(small * gain), cv2.COLOR_BGR2YCrCb))
    # leftover coloured dots and blotches go under a median and a blur at the small scale
    s = max(1.0, min(small.shape[:2]) / 800) * (1 + sigma / 5)
    if sigma > 10:
        sat *= 0.8  # what blotches survive the blur show less
    cr = cv2.GaussianBlur(cv2.medianBlur(cr, 3), (0, 0), s)
    cb = cv2.GaussianBlur(cv2.medianBlur(cb, 3), (0, 0), s)
    if sat != 1.0:
        cr = cv2.addWeighted(cr, sat, cr, 0, 128 * (1 - sat))
        cb = cv2.addWeighted(cb, sat, cb, 0, 128 * (1 - sat))
    # chroma goes up 4x per band; one replicated row and column cover sizes not divisible by 4
    crcb = cv2.copyMakeBorder(cv2.merge([cr, cb]), 0, 1, 0, 1, cv2.BORDER_REPLICATE)
    hs, ws = crcb.shape[:2]

    amount = 0.7 if sigma < 3 else 0.35 if sigma < 8 else 0.0
    out = np.empty((w, h, 3) if rot in (90, 270) else (h, w, 3), np.uint8)
    rots = {90: cv2.ROTATE_90_CLOCKWISE, 180: cv2.ROTATE_180, 270: cv2.ROTATE_90_COUNTERCLOCKWISE}

    def finish(y0, y1):
        # luma: denoise as hard as the noise needs, sharpen less the noisier it is
        m0, m1 = max(y0 - 8, 0), min(y1 + 8, h)
        l = yy[m0:m1]
        if sigma > 1.5:
            l = cv2.bilateralFilter(l, 7 if sigma > 6 else 5, 2.5 * sigma, 3)
        if amount:
            l = cv2.addWeighted(l, 1 + amount, cv2.GaussianBlur(l, (0, 0), 1.2), -amount, 0)
        s0, s1 = max(y0 // 4 - 1, 0), min(y1 // 4 + 2, hs)
        c = cv2.resize(crcb[s0:s1], (ws * 4, (s1 - s0) * 4), interpolation=cv2.INTER_LINEAR)
        c = c[y0 - 4 * s0:y1 - 4 * s0, :w]
        b = cv2.cvtColor(cv2.merge([l[y0 - m0:y1 - m0], c[:, :, 0], c[:, :, 1]]), cv2.COLOR_YCrCb2BGR)
        if matrix is not None:
            b = cv2.transform(b, fm)
        if rot == 270:
            out[:, y0:y1] = cv2.rotate(b, rots[rot])
        elif rot == 90:
            out[:, h - y1:h - y0] = cv2.rotate(b, rots[rot])
        elif rot == 180:
            out[h - y1:h - y0] = cv2.rotate(b, rots[rot])
        else:
            out[y0:y1] = b
    par(finish, h)
    progress(0.85)
    if size and abs(size - max(out.shape[:2])) > 16:
        f = size / max(out.shape[:2])
        cv2.setNumThreads(os.cpu_count() or 4)
        out = cv2.resize(out, None, fx=f, fy=f, interpolation=cv2.INTER_AREA if f < 1 else cv2.INTER_CUBIC)
    if aspect:
        cw, ch = lib.crop_aspect(out.shape[1], out.shape[0], aspect)
        x, y = (out.shape[1] - cw) // 2, (out.shape[0] - ch) // 2
        out = out[y:y + ch, x:x + cw]
    return out


def write_raw(path, frames):
    """test helper: pack uint16 frames as RAW10."""
    with open(path, "wb") as fh:
        for f in frames:
            p = f.reshape(f.shape[0], -1, 4)
            b = np.empty(p.shape[:2] + (5,), np.uint8)
            b[:, :, :4] = p >> 2
            b[:, :, 4] = (p[:, :, 0] & 3) | (p[:, :, 1] & 3) << 2 | (p[:, :, 2] & 3) << 4 | (p[:, :, 3] & 3) << 6
            fh.write(b.tobytes())


def selfcheck():
    import tempfile
    tmp = tempfile.mkdtemp()
    path = os.path.join(tmp, "t.raw")
    try:
        # packing: pixels 1023, 0, 512, 3 -> bytes 0xff 0x00 0x80 0x00, low bits 11 00 00 11
        with open(path, "wb") as fh:
            fh.write(bytes([0xFF, 0x00, 0x80, 0x00, 0b11000011] + [0] * 10) * 4)
        assert Raw(path, 12, 4, 15, 1, 0, 0).rows(0, 2)[:, :4].tolist() == [[1023, 0, 512, 3]] * 2
        # GRBG with only red sites lit must demosaic to red (OpenCV calls GRBG "GB")
        z = np.zeros((8, 8), np.uint16)
        z[0::2, 1::2] = 60000
        px = cv2.cvtColor(z, cv2.COLOR_BayerGB2BGR_EA)[4, 4]
        assert px[2] > 30000 and px[0] < 1000 and px[1] < 1000, px
        # stacking undoes a shift of the second frame, across band edges
        rng = np.random.default_rng(1)
        base = cv2.GaussianBlur(rng.integers(64, 900, (1026, 1028)).astype(np.float32), (0, 0), 3).astype(np.uint16)
        write_raw(path, [base, np.roll(base, (8, -12), axis=(0, 1))])
        st, n = stack(Raw(path, 1028, 1026, 1285, 2, 0, 0), lambda s: None)
        assert n == 2 and (st[32:-32, 32:-32] == 2 * base[32:-34, 32:-34]).all(), "stack sign"
        # Bayer crop: RGGB moves one column so red lands on GRBG red sites
        z = np.full((16, 16), 64, np.uint16)
        z[0::2, 0::2] = 900
        write_raw(path, [z])
        assert (Raw(path, 16, 16, 20, 1, 0, 1).rows(0, 14)[0::2, 1::2] == 900).all()
        # zoom crops the centre with the Bayer phase kept
        z = (np.arange(64)[None, :] + 64 * np.arange(64)[:, None]) % 1024
        write_raw(path, [z.astype(np.uint16)])
        r = Raw(path, 64, 64, 80, 1, 0, 1, zoom=2)
        assert (r.w, r.h) == (28, 28) and r.rows(0, 1)[0, 0] == z[r.dy, r.dx] and r.dx % 2 == 1, (r.dx, r.dy)
        # a lone hot pixel goes, a flat field stays
        f = np.full((32, 32), 300, np.uint16)
        f[10, 10] = 1023
        o = np.empty_like(f)
        C.fix_rows(ptr(f), 32, 32, 40, 0, 32, ptr(o))
        assert (o == 300).all()
        # quads: GRBG means per colour; wb tables per site; luma through an identity matrix
        z = np.tile(np.array([[200, 100], [300, 200]], np.uint16), (4, 4))
        q = np.empty((2, 2, 3), np.float32)
        C.quads(ptr(z), 8, 2, 64, 0, 8, ptr(q))
        assert np.allclose(q, [100 / 2 - 64, 200 / 2 - 64, 300 / 2 - 64]), q
        lut = [np.arange(1024, dtype=np.uint16) * k for k in (1, 2, 3)]
        o = np.empty_like(z)
        C.wb_rows(ptr(z), 8, 0, 8, *map(ptr, lut), ptr(o))
        assert (o[:2, :2] == [[200, 200], [900, 200]]).all(), o[:2, :2]
        bgr = np.full((1, 1, 3), 30000, np.uint16)
        tone, y = tone_lut(1.0), np.empty(1, np.uint8)
        C.ccm_luma(ptr(bgr), 1, ptr(np.hstack([np.eye(3), np.zeros((3, 1))]).astype(np.float32)), ptr(tone), ptr(y))
        assert y[0] == tone[30000], (y, tone[30000])
        # develop: fixed white balance and gain, one stop of ev doubles a linear grey, aspect crops, DNG holds the stack
        z = np.full((258, 320), 64 + 60, np.uint16)
        write_raw(path, [z, z])
        dng = os.path.join(tmp, "t.dng")
        mk = lambda **k: develop(Raw(path, 320, 258, 400, 2, 0, 0), ccm_name="none", log=lambda s: None, wb=(1.0, 1.0),
                                 fixed_gain=1.0, **k)
        a, b = mk(dng=dng), mk(ev=1.0, aspect=1.0)
        assert a.shape == (256, 318, 3) and b.shape == (256, 256, 3), (a.shape, b.shape)
        lin = lambda v: ((v / 255 + 0.055) / 1.055) ** 2.4
        assert 1.7 < lin(float(b[128, 128, 1])) / lin(float(a[128, 128, 1])) < 2.2, (a[128, 128], b[128, 128])
        d = np.fromfile(dng, np.uint16)
        assert (d[-256 * 318:] == 248).all() and d[0] == 0x4949
    finally:
        for p in os.listdir(tmp):
            os.unlink(os.path.join(tmp, p))
        os.rmdir(tmp)


if __name__ == "__main__":
    a = sys.argv[1:]
    if a == ["--selfcheck"]:
        selfcheck()
        sys.exit(print("ok"))
    if len(a) < 5:
        sys.exit(__doc__.strip())
    src, w, h, stride, dst = a[0], int(a[1]), int(a[2]), int(a[3]), a[4]
    opts = dict(zip(a[5::2], a[6::2]))
    dy, dx = {"GRBG": (0, 0), "RGGB": (0, 1), "BGGR": (1, 0), "GBRG": (1, 1)}[opts.get("--bayer", "GRBG")]
    say = lambda f: print(f"{f:.2f}", flush=True)
    fl = lambda k: [float(v) for v in opts[k].split(",")] if k in opts else None
    img = develop(Raw(src, w, h, stride, int(opts.get("--frames", 1)), dy, dx, float(opts.get("--zoom", 1))),
                  black=int(opts.get("--black", 64)), rot=int(opts.get("--rot", 0)),
                  ccm_name=opts.get("--ccm", "s5kjn1"), sat=float(opts.get("--sat", 1.0)),
                  log=lambda s: print(s, file=sys.stderr), progress=say,
                  meter=fl("--meter"), matrix=fl("--matrix"), size=int(opts.get("--size", 0)),
                  wb=fl("--wb"), ev=float(opts.get("--ev", 0)), fixed_gain=float(opts.get("--gain", 0)),
                  aspect=float(opts.get("--aspect", 0)), dng=opts.get("--dng"), exif=fl("--exif"), anon="--anon" in opts)
    # 4:4:4 at 97: 4:2:0 at 93 left 16 px chroma squares and 8 px luma blocks in smooth dark areas
    if not cv2.imwrite(dst, img, [cv2.IMWRITE_JPEG_QUALITY, 97, cv2.IMWRITE_JPEG_SAMPLING_FACTOR,
                                  cv2.IMWRITE_JPEG_SAMPLING_FACTOR_444]):
        sys.exit(f"phonecam-develop: cannot write {dst}")
    if "--exif" in opts:
        lib.add_exif(dst, *fl("--exif"), time.time(), *(["Nothing Phone (1) " + opts["--camera"] + " camera"] if "--camera" in opts else []))
    say(1)
