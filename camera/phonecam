        GLib.timeout_add(1500, self.script, os.environ.get("PHONECAM_DO", "").split())

    def script(self, steps):
        """PHONECAM_DO="flip 3 mode:video set:look=FLAT 4 shutter 10 shutter": the buttons' own handlers
        run in order, numbers are seconds to wait. For checks on the phone without a finger."""
        if not steps:
            return False
        step, wait = steps.pop(0), 200
        name, _, arg = step.partition(":")
        key, _, val = arg.partition("=")
        if step.replace(".", "").isdigit():
            wait = int(float(step) * 1000)
        elif name == "set":
            self.set_option(key, {str(v).lower(): v for r in ROWS if r[0] == key for _l, v in r[3]}[val.lower()])
        elif name == "qrimg":  # qrimg:/path.png changes the test picture ("qrimg:" back to the test pattern)
            self.qrimg = arg or None
            self.start()
        elif name == "qrpill":  # taps the pill
            self.qr_tapped()
        elif name == "qrbtn":  # qrbtn:OPEN presses a button of the card
            b = self.qrcard.get_last_child().get_first_child()
            while b and b.get_name() != arg:
                b = b.get_next_sibling()
            b and b.emit("clicked")
        elif name == "param":  # param:iso=4 sets a tile's value, param:iso returns it to automatic
            self.select(key)
            if val:
                self.adjusted(float(val) if "." in val else int(val))
            elif self.S[key] is not None:
                self.auto_clicked()
            self.adjust_done()
        else:
            {"flip": self.switch, "shutter": self.shutter_clicked, "mode": lambda: self.set_mode(arg),
             "sheet": lambda: self.sheet_open(True), "tap": lambda: self.on_tap(None, 1, *map(float, arg.split(","))),
             "zoom": lambda: self.set_zoom(float(arg)), "quit": self.close,
             "dump": lambda: print("DUMP", self.S["mode"], self.cam[0], self.finder.paintable, self.fresh,
                                   self.pipe and self.pipe.get_state(0), self.finder.rect(), self.finder.rot,
                                   self.frame and self.frame[1:], file=sys.stderr, flush=True)}[name]()
        GLib.timeout_add(wait, self.script, steps)
        return False

    # ---- small drawings: the icon theme here has none of these

    def phys(self, b, ms=18):
        """in retro the button answers the finger with a short buzz, at the press, as a real key does"""
        g = Gtk.GestureClick(propagation_phase=Gtk.PropagationPhase.CAPTURE)
        g.connect("pressed", lambda *_: self.retro and self.S["haptic"] and BUZZ.play(ms))
        b.add_controller(g)

    @staticmethod
    def icon(draw, size=20):
        d = Gtk.DrawingArea(content_width=size, content_height=size, halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER)
        d.set_draw_func(draw)
        return d

    @staticmethod
    def draw_flip(_a, cr, w, h):
        cr.set_source_rgb(1, 1, 1)
        cr.set_line_width(2.2)
        cx, cy, r = w / 2, h / 2, 9
        for a0, a1, tip in ((3.5, 6.0, 6.0), (0.36, 2.85, 2.85)):
            cr.new_path()
            cr.arc(cx, cy, r, a0, a1)
            cr.stroke()
            x, y = cx + r * math.cos(tip), cy + r * math.sin(tip)
            cr.move_to(x - 4, y - 3 if tip > 3 else y + 3)
            cr.line_to(x, y)
            cr.line_to(x + 4, y - 3 if tip > 3 else y + 3)
            cr.stroke()

    @staticmethod
    def draw_sliders(_a, cr, w, h):
        cr.set_source_rgb(1, 1, 1)
        cr.set_line_width(1.8)
        for y, kx in ((5, 13), (10, 6), (15, 11)):
            cr.move_to(2, y)
            cr.line_to(18, y)
            cr.stroke()
            cr.arc(kx, y, 2.6, 0, 6.2832)
            cr.fill()

    def draw_shutter(self, _a, cr, w, h):
        """white ring; inside it a white disc for photos, a red one for video, a red square while recording"""
        if self.retro:  # a metal release button in its collar
            import cairo
            for r, top, bottom in ((w / 2 - 1, .45, .78), (w / 2 - 7, .97, .62)):
                g = cairo.LinearGradient(0, h / 2 - r, 0, h / 2 + r)
                g.add_color_stop_rgb(0, top, top, top + .02)
                g.add_color_stop_rgb(1, bottom, bottom, bottom + .02)
                cr.set_source(g)
                cr.arc(w / 2, h / 2, r, 0, 6.2832)
                cr.fill()
            if not (self.filming or self.rec):
                return
            cr.set_source_rgb(*RED)
            if not self.rec:
                cr.arc(w / 2, h / 2, 7, 0, 6.2832)
                return cr.fill()
        else:
            cr.set_source_rgb(1, 1, 1)
            cr.set_line_width(3)
            cr.arc(w / 2, h / 2, w / 2 - 2, 0, 6.2832)
            cr.stroke()
        if self.filming:
            cr.set_source_rgb(*RED)
        if self.rec:
            r, k = 13, 5
            x, y = w / 2 - r, h / 2 - r
            for i, (cx, cy) in enumerate(((x + 2 * r - k, y + k), (x + 2 * r - k, y + 2 * r - k), (x + k, y + 2 * r - k), (x + k, y + k))):
                cr.arc(cx, cy, k, (i - 1) * math.pi / 2, i * math.pi / 2)
            cr.close_path()
        else:
            cr.arc(w / 2, h / 2, w / 2 - 8, 0, 6.2832)
        cr.fill()

    def draw_bolt(self, _a, cr, w, h):
        on = self.S["flash"] != "OFF"
        cr.set_source_rgb(*(0, 0, 0) if on else (1, 1, 1))
        for i, (x, y) in enumerate(((11.5, 1.5), (4.5, 11), (9, 11), (8, 18.5), (15.5, 8.5), (10.5, 8.5))):
            (cr.line_to if i else cr.move_to)(x, y)
        cr.close_path()
        if self.S["flash"] == "TORCH" or not on:
            cr.fill()
        else:
            cr.set_line_width(1.6)
            cr.stroke()

    def draw_scope(self, _a, cr, w, h):
        """luma histogram with clipping lights, audio level while recording"""
        if self.hist is None:
            return
        cr.set_source_rgba(0, 0, 0, .55)
        cr.rectangle(0, 0, w, h)
        cr.fill()
        n, top = len(self.hist), max(float(self.hist[2:-2].max()), 1.0)
        cr.set_source_rgba(1, 1, 1, .85)
        for i, v in enumerate(self.hist):
            bh = min(1.0, v / top) * (h - 12)
            cr.rectangle(4 + i * (w - 8) / n, h - 4 - bh, (w - 8) / n - .5, bh)
        cr.fill()
        lo, hi = self.clip
        for x, frac, rgb in ((7, lo, (.35, .55, 1)), (w - 7, hi, RED)):
            if frac > .005:
                cr.set_source_rgb(*rgb)
                cr.arc(x, 6, 3, 0, 6.2832)
                cr.fill()
        if self.audio is not None:  # peak, -60..0 dB across the bottom edge
            cr.set_source_rgb(*RED if self.audio > -3 else (1, 1, 1))
            cr.rectangle(4, h - 3, (w - 8) * min(max((self.audio + 60) / 60, 0), 1), 2)
            cr.fill()

    def draw_ring(self, _a, cr, w, h):
        """progress of the photo being developed, around the thumbnail"""
        if not self.pending:
            return
        cx, cy, r = w / 2, h / 2, min(w, h) / 2 - 2.5
        cr.set_line_width(3)
        cr.set_source_rgba(0, 0, 0, .45)
        cr.arc(cx, cy, r, 0, 2 * math.pi)
        cr.stroke()
        cr.set_source_rgb(1, 1, 1)
        cr.arc(cx, cy, r, -math.pi / 2, -math.pi / 2 + 2 * math.pi * max(self.progress, .04))
        cr.stroke()

    def still(self):
        """the newest frame as a texture of our own. Never the sink's current image: that one holds a
        camera buffer, the buffer keeps libcamera's manager alive across a restart, and the camera then
        still calls into the pipeline that was just freed (libcamerasrc never disconnects) and crashes."""
        if self.retro and self.rframe:
            data, w, h = self.rframe
            return Gdk.MemoryTexture.new(w, h, Gdk.MemoryFormat.B8G8R8A8, GLib.Bytes.new(data), w * 4)
        if not self.frame:
            return None
        data, w, h, fmt = self.frame
        small = cv2.resize(np.frombuffer(data, np.uint8).reshape(h, -1, 4)[:, :w], (w // 2, h // 2), interpolation=cv2.INTER_AREA)
        return Gdk.MemoryTexture.new(w // 2, h // 2, Gdk.MemoryFormat.B8G8R8A8 if fmt.startswith("BGR") else
                                     Gdk.MemoryFormat.R8G8B8A8, GLib.Bytes.new(small.tobytes()), w // 2 * 4)

    def show_thumb(self, p, rot=0, mirror=False):
        """a small square cut of a picture, turned upright; a bare picture would ask for its full size"""
        n, a = 48, p.get_intrinsic_aspect_ratio() or 1
        w, h = (n * a, n) if a > 1 else (n, n / a)
        sn = Gtk.Snapshot()
        sn.push_clip(Graphene.Rect().init(0, 0, n, n))
        sn.translate(Graphene.Point().init(n / 2, n / 2))
        sn.scale(-1 if mirror else 1, 1)
        sn.rotate(rot)
        sn.translate(Graphene.Point().init(-w / 2, -h / 2))
        p.snapshot(sn, w, h)
        sn.pop()
        self.thumb_pic.set_paintable(sn.to_paintable(Graphene.Size().init(n, n)))

    # ---- state

    def save(self):
        try:
            os.makedirs(os.path.dirname(CONF), exist_ok=True)
            with open(CONF, "w") as f:
                json.dump(self.S, f)
        except OSError:
            pass

    @property
    def cam(self):
        return CAMERAS[self.idx]

    @property
    def manual(self):
        return self.S["mode"] != "retro"

    @property
    def retro(self):
        return self.S["mode"] == "retro"

    @property
    def filming(self):
        """the shutter starts a clip"""
        return self.S["mode"] == "video" or self.retro and self.S["rcap"] == "VIDEO"

    @property
    def fps(self):
        return min(self.S["fps"], FPS_MAX[self.cam[0]])

    def lens_ok(self):
        return self.has_lens and self.cam[0] == "back"

    def set_mode(self, mode, first=False):
        if self.rec or self.busy:
            return
        was = self.S["mode"]
        self.S["mode"] = mode
        retro_ui = mode == "retro"
        for m, (b, d) in self.modes.items():
            d.set(m, (1, 1, 1) if m == mode else (.62, .64, .7) if retro_ui else (.5, .5, .5))
        (self.add_css_class if retro_ui else self.remove_css_class)("retro")
        self.top.set_visible(not retro_ui)
        self.cambody.set_visible(retro_ui)
        self.finder.inset = 0 if retro_ui else 88
        if not retro_ui:
            self.finder.osd = None
        self.shutter_art.queue_draw()
        self.select(None)
        self.build_tiles()
        self.zoom_box.set_visible(mode == "pro")
        if mode == "video":
            self.set_zoom(1)
        self.refresh()
        if first or (mode in ("video", "retro") or was in ("video", "retro")) and mode != was or not self.pipe:
            self.start()
        else:
            self.push_controls()
        self.save()

    def refresh(self):
        """everything on screen that follows the settings"""
        S, f = self.S, self.finder
        photo = S["mode"] != "video"
        name = S["aspect"] if photo else S["vguide"]
        f.aspect = dict(lib.ASPECTS).get(name, 0.0) if name not in ("4:3", "OFF") else 0.0
        f.grid, f.legend = S["grid"], self.manual and S["falsecolor"]
        f.set_filter(self.view_matrix())
        self.scope.set_visible(self.manual and S["hist"])
        self.light_icon.queue_draw()
        (self.light.add_css_class if S["flash"] != "OFF" else self.light.remove_css_class)("on")
        self.set_led(S["flash"] == "TORCH" and not self.paused)
        self.update_status()
        for k in self.tiles:
            self.update_tile(k)
        f.queue_draw()

    def view_matrix(self):
        ops = []
        if self.manual and self.S["wb"] and self.wb_isp and self.ctl_sent.get("awb-enable") == "false":
            # white balance being dialled: shown as the ratio to what the ISP has now (display values are gamma encoded)
            rg, bg = lib.kelvin_gains(self.S["wb"], self.S["tint"])
            isp = [float(v) for v in self.ctl_sent["colour-gains"].strip("<>").split(",")]
            ops.append(diag((rg / isp[0]) ** .45, 1, (bg / isp[1]) ** .45))
        if self.S["mode"] == "pro" and self.S["ev"]:
            ops.append(diag(*(2 ** self.S["ev"],) * 3))
        if self.S["mode"] == "pro" and FILTERS[self.S["filter"]][1]:
            ops.append(FILTERS[self.S["filter"]][1])
        return affine(*ops) if ops else None

    def update_status(self):
        S = self.S
        if self.rec:
            t = int(time.monotonic() - self.rec["t0"])
            left = shutil.disk_usage(VIDS).free * 8 / ((RETRO_KBIT if self.retro else VIDEO[S["vres"]][2]) * 1000) / 60
            text = f"REC {t // 60:02d}:{t % 60:02d} | {left:.0f} MIN" + (" | NO MIC" if not self.rec["mic"] else "") \
                + (f" | DROP {self.rec['drops']}" if self.rec["drops"] else "")
            if self.retro:
                return self.update_osd(text.split(" | ")[0] + text.partition(" MIN")[2].replace(" | ", " "))
            return self.status.set(text, RED)
        if S["mode"] == "video":
            text = f"{S['vres']} | {self.fps} FPS | {S['look']}"
        elif self.retro:
            return self.update_osd()
        else:
            modes = self.cam[4]
            text = f"{modes[min(S['size'], len(modes) - 1)][0]} | {S['aspect']}" + (" | " + S["stack"] if S["stack"] != "AUTO" else "") \
                + (" | RAW" if S["dng"] else "") + (f" | {S['timer']}S" if S["timer"] else "")
        self.status.set(text, (1, 1, 1))

    def update_osd(self, rec=""):
        S, batt = self.S, 1.0
        try:
            with open(glob.glob("/sys/class/power_supply/*/capacity")[0]) as f:
                batt = int(f.read()) / 100
        except (OSError, ValueError, IndexError):
            pass
        os.makedirs(PICS, exist_ok=True)
        free = shutil.disk_usage(PICS).free
        left = f"{min(free * 8 / (RETRO_KBIT * 1000) / 60, 999):.0f}MIN" if self.filming else str(int(min(free / 150e3, 9999)))
        light = "FLASH" if S["flash"] == "OFF" and retro.STYLES[S["rstyle"]].get("flash") and not self.filming else S["flash"]
        info = [S["rsize"]] * (not self.filming) + [light] * (light != "OFF") + [f"{S['timer']}S"] * bool(S["timer"] and not self.filming)
        z = self.finder.zoom
        try:
            shots = sum(1 for f in os.listdir(PICS) if f.startswith(("IMG_", "VID_")))
        except OSError:
            shots = 0
        self.finder.osd = S["osd"] and dict(date=time.strftime("%d/%m/%y %H:%M"), file=f"100-{shots % 10000:04d}", style=S["rstyle"], cap="VIDEO" if self.filming else "PHOTO", left=left, batt=batt, rec=rec,
                               zoom=f"{z:.1f}X" if z > 1 else "", info=" ".join(info))
        self.knob.set_halign(Gtk.Align.END if self.filming else Gtk.Align.START)
        self.finder.queue_draw()

    # ---- value tiles and the ruler

    def params(self):
        if self.retro:  # what the photographer can turn on top of the style
            return list(RADJ)
        p = ["fps", "angle"] if self.S["mode"] == "video" else ["shutter"]
        p += ["iso"] + (["ev"] if self.S["mode"] == "pro" else []) + ["wb", "tint"]
        return p + (["focus"] if self.lens_ok() else [])

    def build_tiles(self):
        while (c := self.tiles_box.get_first_child()):
            self.tiles_box.remove(c)
        self.tiles = {}
        for k in self.params():
            name = Gtk.Label(label={"wb": "WB", "iso": "ISO", "ev": "EV", "fps": "FPS"}.get(k, RADJ[k][0] if k in RADJ else k.upper()),
                             css_classes=["tname"])
            val = Gtk.Label(css_classes=["tval"])
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
            box.append(name)
            box.append(val)
            b = Gtk.Button(child=box, css_classes=["tile"])
            b.connect("clicked", lambda _b, k=k: self.select(None if self.param == k else k))
            self.tiles_box.append(b)
            self.tiles[k] = (b, val)
        self.tiles_box.set_visible(bool(self.tiles))

    def next_choice(self, k):
        """a button of the old camera: each press takes the next choice"""
        if self.rec or self.busy:
            return
        opts = [v for _l, v in next(r[3] for r in ROWS if r[0] == k)]
        self.set_option(k, opts[(opts.index(self.S[k]) + 1) % len(opts)])

    def tile_text(self, k):
        """(text, is automatic)"""
        S, (exp, gain) = self.S, self.live
        if k in RADJ:
            return (f"{S[k]:+.1f}" if k == "rev" else f"{S[k]:+d}" if k == "rwarm" else f"{S[k]:.1f}X"), S[k] == DEFAULTS[k]
        if k == "shutter":
            return lib.shutter_label(S[k] or exp), not S[k]
        if k == "angle":
            return f"{S[k] or min(360, exp * self.fps * 360 / 1e6):.4g}°", not S[k]
        if k == "iso":
            return str(min(ISOS, key=lambda i: abs(math.log(i / 100 / (S[k] or gain))))), not S[k]
        if k == "ev":
            return f"{S[k]:+.1f}", False
        if k == "wb":
            return (f"{S[k]}K", False) if S[k] else ("AWB", True)
        if k == "tint":
            return (f"{S[k]:+d}", False) if S["wb"] else ("-", True)
        if k == "focus":
            return ("AF", True) if S[k] is None else (f"MF {S[k]}", False)
        return str(self.fps if k == "fps" else S[k]), False

    def update_tile(self, k):
        b, val = self.tiles[k]
        text, auto = self.tile_text(k)
        val.set_label(text)
        (b.add_css_class if auto else b.remove_css_class)("auto")
        (b.add_css_class if k == self.param else b.remove_css_class)("on")
        if k == self.param:
            has_auto = k in ("shutter", "angle", "iso", "wb", "focus")
            self.autob.set_label({"focus": "AF"}.get(k, "AUTO") if has_auto else "RESET")
            (self.autob.add_css_class if auto and has_auto else self.autob.remove_css_class)("on")

    def select(self, k):
        self.param = k
        if k:
            S = self.S
            items, major = ([(f"{v:g}", v) for v in RADJ[k][1]], RADJ[k][2]) if k in RADJ else {
                "shutter": ([(lib.shutter_label(u), u) for u in SHUTTERS], 3),
                "angle": ([(f"{a:g}", a) for a in ANGLES], 1),
                "iso": (list(zip(map(str, ISOS), GAINS)), 3),
                "ev": ([(f"{i / 3:+.0f}", i / 3) for i in range(-9, 10)], 3),
                "wb": ([(f"{k_}", k_) for k_ in range(2000, 10001, 100)], 10),
                "tint": ([(f"{t:+d}", t) for t in range(-50, 51, 5)], 2),
                "focus": ([(f"{i}", i) for i in range(0, 101)], 10),
                "fps": ([(str(f), f) for f in (24, 25, 30) if f <= FPS_MAX[self.cam[0]]], 1),
            }[k]
            cur = S[k]
            if cur is None:  # the scale starts where the automatic value is now
                cur = {"shutter": self.live[0], "angle": 180, "iso": self.live[1], "wb": 5000,
                       "focus": round((self.lens_pos - LENS_LO) * 100 / (LENS_HI - LENS_LO))}[k]
            self.ruler.load(items, cur, major)
        self.adjust.set_reveal_child(bool(k))
        for t in self.tiles:
            self.update_tile(t)

    def adjusted(self, value):
        k, S = self.param, self.S
        self.touched = time.monotonic()
        S[k] = value
        if k == "tint" and not S["wb"]:
            S["wb"] = 5000
        if k == "focus":
            self.af = None
            self.set_lens(LENS_LO + value * (LENS_HI - LENS_LO) // 100)
        if k == "fps":
            self.set_fps()
        self.after_param(k)

    def adjust_done(self):
        if self.param in ("wb", "tint"):
            self.push_controls()

    def auto_clicked(self, *_):
        k, S = self.param, self.S
        if k in ("ev", "tint"):
            S[k] = 0
        elif k in RADJ:
            S[k] = DEFAULTS[k]
        elif k == "fps":
            S[k] = 30
            self.set_fps()
        elif S[k] is None:  # automatic to manual, from the value in use now
            self.adjusted(self.ruler.items[self.ruler.i][1])
            return
        else:
            S[k] = None
            if k == "focus":
                self.af_req = True
        self.select(k)
        self.after_param(k)
        self.adjust_done()

    def after_param(self, k):
        for t in self.tiles:
            self.update_tile(t)
        if k in ("ev", "wb", "tint"):
            self.finder.set_filter(self.view_matrix())
        elif k != "focus" and k not in RADJ:
            self.push_controls()
        self.update_status()
        self.save()

    # ---- settings sheet

    def sheet_open(self, show):
        if show and (self.rec or self.busy):
            return
        if show:
            while (c := self.rows.get_first_child()):
                self.rows.remove(c)
            for key, title, hint, options, modes in ROWS:
                if key == "vres":
                    options = [o for o in options if VIDEO[o[1]][0] <= VIDEO_MAX[self.cam[0]]]
                if self.S["mode"] not in modes.split() or (key == "size" and len(self.cam[4]) < 2) \
                        or (key == "flash" and not os.access(LED, os.W_OK) and not TESTSRC):
                    continue
                row = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=5)
                row.append(Gtk.Label(label=title, css_classes=["rtitle"], xalign=0))
                seg = Gtk.Box(homogeneous=True)
                for label, value in options:
                    b = Gtk.Button(label=label, css_classes=["seg", "on"] if self.S[key] == value else ["seg"], hexpand=True)
                    b.connect("clicked", self.option, key, value, seg)
                    seg.append(b)
                row.append(seg)
                if hint:
                    row.append(Gtk.Label(label=hint, css_classes=["rhint"], xalign=0, wrap=True))
                self.rows.append(row)
        self.sheet.set_reveal_child(show)

    def option(self, button, key, value, seg):
        c = seg.get_first_child()
        while c:
            (c.add_css_class if c is button else c.remove_css_class)("on")
            c = c.get_next_sibling()
        self.set_option(key, value)

    def set_option(self, key, value):
        self.S[key] = value
        if key == "vres":
            self.start()
        elif key == "look":
            self.push_controls()
        elif key == "rcap":
            self.shutter_art.queue_draw()
        self.refresh()
        self.save()

    def next_light(self, *_):
        order = ["OFF", "FLASH", "TORCH"]
        self.S["flash"] = order[(order.index(self.S["flash"]) + 1) % 3]
        self.refresh()
        self.save()

    def set_led(self, on):
        try:
            with open(LED, "w") as f:
                f.write("120" if on else "0")
        except OSError:
            pass

    # ---- pipeline

    def controls(self):
        """libcamera controls for the mode and manual values, as libcamerasrc properties"""
        S = self.S
        us = gain = wb = None
        look = LOOKS["STANDARD"]
        if S["mode"] == "pro":
            us, gain = S["shutter"], S["iso"]
        elif S["mode"] == "video":
            us, gain, look = S["angle"] and lib.shutter_us(S["angle"], self.fps), S["iso"], LOOKS[S["look"]]
            if self.locked:
                us, gain, wb = us or self.locked[0], gain or self.locked[1], self.locked[2]
        if self.manual and S["wb"]:
            wb = lib.kelvin_gains(S["wb"], S["tint"])
        self.wb_isp = wb and tuple(min(max(g, 1.0), 3.99) for g in wb)
        # every key every time, values that are ignored while their mode is automatic included:
        # a key first set while frames flow would be added to a table libcamera's own thread is writing
        return {"exposure-time-mode": "manual" if us else "auto", "exposure-time": str(int(min(us or 10000, VIEW_MAX_US))),
                "analogue-gain-mode": "manual" if gain else "auto", "analogue-gain": f"{gain or 1:.3f}",
                "awb-enable": "false" if wb else "true", "colour-gains": "<%.3f,%.3f>" % (self.wb_isp or (1.5, 1.5)),
                "contrast": f"{look[0]:.2f}", "saturation": f"{look[1]:.2f}"}

    def push_controls(self):
        """send what changed to the running camera. libcamerasrc loses about every other change
        (it attaches them to a request it may then drop), so each one is set four times."""
        want = self.controls()
        self.ctl_todo.update({k: v for k, v in want.items() if self.ctl_sent.get(k) != v})
        self.ctl_sent = want
        if self.ctl_todo and not self.ctl_left:
            GLib.timeout_add(40, self.ctl_tick)
        self.ctl_left = 4 if self.ctl_todo else 0
        self.finder.set_filter(self.view_matrix())

    def ctl_tick(self):
        if self.src and time.monotonic() - self.started > .7:  # not while its first frames set the table up
            for k, v in self.ctl_todo.items():
                Gst.util_set_object_arg(self.src, k, v)
            self.ctl_left -= 1
        if self.ctl_left <= 0 or not self.src:
            self.ctl_todo, self.ctl_left = {}, 0
        return self.ctl_left > 0

    def set_fps(self):
        """the frame rate is the sensor's vertical blanking; libcamera leaves that control alone"""
        if TESTSRC or not self.pipe or self.S["mode"] != "video":
            return
        threading.Thread(target=subprocess.run, args=([os.path.join(BIN, "phonecam-raw"), "--fps", self.cam[0],
                                                       str(self.fps)],), daemon=True).start()

    def stop(self):
        if self.pipe:
            self.pipe.get_bus().remove_signal_watch()
            with self.tap_lock:  # no camera buffer may outlive its pipeline, see still()
                self.tap = None
            if self.fresh:
                for h in self.fresh[1]:
                    self.fresh[0].disconnect(h)
                self.fresh = None
            else:
                self.finder.set_paintable(self.still())
            self.pipe.set_state(Gst.State.NULL)
            self.pipe = self.src = None

    def start(self, record=None):
        self.stop()
        self.paused = False
        name, path, _rot, _mirror, _modes = self.cam
        video = self.S["mode"] == "video"
        w, h, kbit = VIDEO[self.S["vres"]] if video else (2048, 1536, 0)
        if TESTSRC and self.qrimg:  # test hook: a PNG (a QR code on grey) as the camera picture
            src = (f'filesrc location="{self.qrimg}" ! decodebin ! imagefreeze is-live=true ! videoconvertscale'
                   f" ! video/x-raw,format=RGBA,width={w},height={h},framerate=30/1")
        elif TESTSRC:
            src = f"videotestsrc is-live=true pattern=smpte ! video/x-raw,format=RGBA,width={w},height={h},framerate=30/1"
        else:
            src = f'libcamerasrc name=src camera-name="{path}" ! video/x-raw,width={w},height={h}'
        # the screen gets a scaled copy, never the camera's own buffer: GTK keeps the last picture it drew,
        # and a camera buffer alive after its pipeline wrecks the next one (see still())
        view = "width=1280,height=720" if video else "width=1440,height=1080"
        tap = " t. ! queue leaky=downstream max-size-buffers=1 ! appsink name=tap max-buffers=1 drop=true sync=false"
        if self.retro:
            # camera frames go to retro_loop at twice the old camera's size (halving averages the sensor noise),
            # come back with the look on, and that is what the screen and the encoder get
            desc = (src + " ! tee name=t t. ! queue leaky=downstream max-size-buffers=1 ! videoconvertscale n-threads=2"
                    " ! video/x-raw,format=BGR,width=1280,height=960 ! appsink name=rin max-buffers=1 drop=true sync=false" + tap
                    + " appsrc name=rout is-live=true do-timestamp=true format=time ! tee name=r"
                    # async=false: these sinks get nothing until the pipeline plays, so it must not wait for them
                    " r. ! queue leaky=downstream max-size-buffers=2 ! gtk4paintablesink name=sink async=false")
        else:
            desc = (src + " ! tee name=t t. ! queue leaky=downstream max-size-buffers=2 ! videoconvertscale n-threads=2"
                    f" ! video/x-raw,format=BGRA,{view} ! gtk4paintablesink name=sink" + tap)
        mic = None
        if record and self.retro:
            mic = self.microphone()
            desc += (" r. ! queue name=recq leaky=downstream max-size-buffers=8 ! videoconvert n-threads=2"
                     f" ! video/x-raw,format=I420 ! x264enc speed-preset=ultrafast bitrate={RETRO_KBIT} key-int-max=30 threads=4"
                     f" ! h264parse ! queue ! mux. mp4mux name=mux ! filesink async=false location=\"{record}\"")
        elif record:
            mic = self.microphone()
            # the picture is stored as the sensor sees it; players turn it by the orientation tag
            turn = (self.cam[2] - self.theta if name == "back" else self.cam[2] + self.theta) % 360
            desc += (f" t. ! queue name=recq leaky=downstream max-size-buffers=8 ! videoconvert n-threads=4"
                     f" ! video/x-raw,format=I420 ! x264enc speed-preset=ultrafast bitrate={kbit} key-int-max=30 threads=6"
                     + f" ! h264parse ! taginject tags=\"image-orientation=(string)rotate-{turn}\""
                     f" ! queue ! mux. mp4mux name=mux ! filesink location=\"{record}\"")
            if mic:
                desc += (f" pulsesrc device={mic} ! audioconvert ! audioresample ! level name=level interval=100000000"
                         " ! fdkaacenc bitrate=128000 ! queue ! mux.")
        try:
            self.pipe = Gst.parse_launch(desc)
        except GLib.Error as e:
            return self.show_msg(f"Camera unavailable\n{e.message}")
        self.src, self.tap = self.pipe.get_by_name("src"), self.pipe.get_by_name("tap")
        if self.retro:
            self.orient()  # before the first frame: a clip keeps this shape
            threading.Thread(target=self.retro_loop, args=(self.pipe, self.pipe.get_by_name("rin"), self.pipe.get_by_name("rout"), bool(record)),
                             daemon=True).start()
        self.ctl_sent, self.ctl_todo, self.ctl_left, self.started = self.controls(), {}, 0, time.monotonic()
        if self.src:
            for k, v in self.ctl_sent.items():
                Gst.util_set_object_arg(self.src, k, v)
        self.finder.set_filter(self.view_matrix())
        if record:
            self.pipe.get_by_name("recq").connect("overrun", self.on_drop)
        pt = self.pipe.get_by_name("sink").props.paintable
        if os.environ.get("PHONECAM_DEBUG"):  # test hook: frames drawn per second, printed by tick()
            pt.connect("invalidate-contents", lambda *_: setattr(self, "drawn", getattr(self, "drawn", 0) + 1))
        # the still frame put up by stop() stays until the first new frame (a new size comes as its own signal).
        # Nothing here may keep the paintable alive past its pipeline, see still().
        self.fresh = (pt, [pt.connect(sig, self.first_frame) for sig in ("invalidate-contents", "invalidate-size")])
        self.starts = n = self.starts + 1
        GLib.timeout_add(2500, lambda: n == self.starts and self.fresh and self.first_frame(self.fresh[0]) and False)
        bus = self.pipe.get_bus()
        bus.add_signal_watch()
        bus.connect("message::error", self.on_error)
        bus.connect("message::eos", lambda *_: self.recorded())
        bus.connect("message::element", self.on_element)
        self.show_msg("")
        self.orient()
        if self.pipe.set_state(Gst.State.PLAYING) == Gst.StateChangeReturn.FAILURE:
            return self.show_msg("Camera busy or missing")
        self.af_ref, self.af_seen = None, []
        if self.lens_ok():
            if self.S["focus"] is not None and self.manual:
                self.set_lens(LENS_LO + self.S["focus"] * (LENS_HI - LENS_LO) // 100)
            elif self.af_good is None:
                self.set_lens(LENS_REST)
                self.af_req = True
            else:  # a restart after a photo keeps the focus it had
                self.set_lens(self.af_good)
        if video and self.fps != FPS_MAX[self.cam[0]]:
            GLib.timeout_add(600, lambda: self.set_fps() and False)
        return mic

    def radj(self):
        return {name: self.S[k] for k, (_l, _v, _m, name) in RADJ.items()}

    def retro_loop(self, pipe, rin, rout, hold):
        """worker thread, one per pipeline: camera frame in, the old camera's frame out"""
        look = key = caps = None
        turns = {90: cv2.ROTATE_90_CLOCKWISE, 180: cv2.ROTATE_180, 270: cv2.ROTATE_90_COUNTERCLOCKWISE}
        while self.pipe is pipe and not self.quit:
            sample = rin.emit("try-pull-sample", 100 * Gst.MSECOND)
            if not sample:
                time.sleep(.01)  # not started yet: the pull returns at once
                continue
            st, buf = sample.get_caps().get_structure(0), sample.get_buffer()
            w, h = st.get_value("width"), st.get_value("height")
            ok, info = buf.map(Gst.MapFlags.READ)
            if not ok:
                continue
            arr = np.frombuffer(info.data, np.uint8)
            arr = arr[:h * (arr.size // h)].reshape(h, arr.size // h)[:, :w * 3].reshape(h, w, 3)
            z = self.finder.zoom  # digital zoom: the middle of the frame, blown up
            cw, ch = int(w / z) // 2 * 2, int(h / z) // 2 * 2
            arr = arr[(h - ch) // 2:(h + ch) // 2, (w - cw) // 2:(w + cw) // 2]
            # the copy that lets the camera buffer go; INTER_AREA is the average a small sensor would have made
            img = cv2.resize(arr, (640, 480), interpolation=cv2.INTER_AREA if cw >= 640 else cv2.INTER_LINEAR)
            del arr
            buf.unmap(info)
            del sample, buf, info
            turn, style = self.rturn, self.S["rstyle"]
            if turn:
                img = cv2.rotate(img, turns[turn])
            if self.cam[3]:
                img = cv2.flip(img, 1)  # the front camera shows and keeps the mirror picture
            oh, ow = img.shape[:2]
            if key != (style, ow, oh):
                key, look = (style, ow, oh), retro.Look(style, ow, oh)
                caps = Gst.Caps.from_string(f"video/x-raw,format=BGRx,width={ow},height={oh},framerate=30/1")
            look.adj = self.radj()
            out = cv2.cvtColor(look.render(img, time.time() if self.S["stamp"] else None, live=True), cv2.COLOR_BGR2BGRA).tobytes()
            self.rframe = (out, ow, oh)
            if hold and time.monotonic() - self.started < 1.6:
                continue  # a clip starts once the restarted camera has its white balance back (green until then)
            if self.pipe is pipe:
                rout.emit("push-sample", Gst.Sample.new(Gst.Buffer.new_wrapped(out), caps, None, None))

    def first_frame(self, pt):
        if self.fresh and self.fresh[0] is pt:
            for h in self.fresh[1]:
                pt.disconnect(h)
            self.fresh = None
            self.finder.set_paintable(pt)

    def show_msg(self, text):
        self.msg.set_text(text)
        self.msg.set_visible(bool(text))

    def on_error(self, _bus, m):
        err, _ = m.parse_error()
        rec, self.rec = self.rec, None
        self.stop()
        self.show_msg(f"Camera error\n{err.message}")
        if rec:
            self.record_ui(False)

    def switch(self, *_):
        if self.rec or self.busy:
            return
        self.idx = (self.idx + 1) % len(CAMERAS)
        if VIDEO[self.S["vres"]][0] > VIDEO_MAX[self.cam[0]]:
            self.S["vres"] = "1080P"
        self.frame = self.af_good = None  # the other camera's picture would show turned the wrong way
        self.clear_meter()
        self.set_zoom(1)
        self.select(None)
        self.build_tiles()
        self.set_lens(-1)
        self.refresh()
        self.start()

    def set_zoom(self, z):
        z = min(max(z, 1.0), 8.0 if not self.retro else 4.0) if self.S["mode"] != "video" else 1.0
        if abs(z - round(z)) < .06:
            z = float(round(z))
        if self.finder.zoom != z:
            self.clear_meter()
        self.finder.zoom = z
        if self.retro:
            self.update_osd()
        self.finder.queue_draw()
        for c, cz in zip(self.chips, ZOOMS):
            on = cz <= z < (ZOOMS + (99,))[ZOOMS.index(cz) + 1]
            c.set_label((f"{z:.1f}x" if z != cz else f"{cz}x") if on else f"{cz}x")
            (c.add_css_class if on else c.remove_css_class)("on")

    def on_tap(self, _g, _n, x, y):
        """a tap sets where to focus and what to expose the next photo for"""
        self.touched = time.monotonic()
        if self.sheet.get_reveal_child():
            return self.sheet_open(False)
        if self.paused:
            return self.start()
        if self.param:
            return self.select(None)
        p = self.finder.to_sensor(x, y)
        if not p:
            return
        self.meter = p
        self.finder.ring, self.finder.ring_ok = (x, y), not self.lens_ok() or self.S["focus"] is not None
        if self.lens_ok() and (self.S["focus"] is None or not self.manual):
            self.af_req = True
        self.finder.queue_draw()
        t = self.meter_t = time.monotonic()
        GLib.timeout_add(10000, lambda: self.meter_t == t and self.clear_meter())

    def clear_meter(self):
        self.meter = self.finder.ring = None
        self.finder.queue_draw()

    # ---- orientation

    def on_layout(self, _s, w, h):
        land = w > h
        if land != self.landscape:
            self.landscape = land
            GLib.idle_add(self.relayout)

    def relayout(self):
        land = self.landscape
        self.body.set_orientation(Gtk.Orientation.HORIZONTAL if land else Gtk.Orientation.VERTICAL)
        self.panel.set_size_request(330 if land else -1, -1)
        self.sheet.set_halign(Gtk.Align.END if land else Gtk.Align.FILL)
        self.sheet.set_size_request(340 if land else -1, -1)
        self.scroll.set_max_content_height(250 if land else 470)
        (self.add_css_class if land else self.remove_css_class)("land")
        # the camera's back: in the hand sideways the switch sits on top, the pad under it, DISP and MENU at the foot
        disp, pad, menu = self.body_keys
        for wdg in self.body_keys:
            if wdg.get_parent():
                self.keys.remove(wdg)
        for wdg, col, row, wide in ((pad, 0, 0, 2), (disp, 0, 1, 1), (menu, 1, 1, 1)) if land else ((disp, 0, 0, 1), (pad, 1, 0, 1), (menu, 2, 0, 1)):
            self.keys.attach(wdg, col, row, wide, 1)
        self.cambody.reorder_child_after(self.switch_row, None if land else self.keys)
        self.keys.set_row_spacing(6 if land else 12)
        self.finder.inset = 0 if land else 88
        self.orient()

    def orient(self):
        """turn the picture for the way the screen is turned"""
        if self.landscape:
            self.ui_theta = self.theta if self.theta in (90, 270) else self.ui_theta if self.ui_theta in (90, 270) else 90
        else:
            self.ui_theta = 0
        name, _p, rot, mirror, _m = self.cam
        self.finder.rot = (rot - self.ui_theta if name == "back" else rot + self.ui_theta) % 360
        self.finder.mirror = mirror
        if self.retro:
            # the look has a top and a bottom (date stamp, tape lines): frames are turned upright for the way
            # the phone is held before the look goes on, and the screen turns only what is left
            if not self.rec:  # a clip keeps the shape it started with
                self.rturn = (rot - self.theta if name == "back" else rot + self.theta) % 360
            self.finder.rot, self.finder.mirror, self.finder.pre = (self.finder.rot - self.rturn) % 360, False, (self.rturn, mirror)
        else:
            self.finder.pre = None
        self.finder.queue_draw()

    def gravity(self):
        """accelerometer: which side is up (for the saved photo) and the roll for the level"""
        while not self.quit:
            try:
                p = subprocess.Popen(["ssccli", "--sensor", "accelerometer", "--timeout", "600"], stdout=subprocess.PIPE,
                                     stderr=subprocess.DEVNULL, text=True)
            except OSError:
                return
            self.ssc, last = p, 0.0
            for line in p.stdout:
                now = time.monotonic()
                if self.quit:
                    break
                if now - last < .1 or "X=" not in line:
                    continue
                last = now
                try:
                    x, y = (float(line.split(a + "=")[1].split()[0]) for a in "XY")
                except (IndexError, ValueError):
                    continue
                if math.hypot(x, y) < 3:  # lying flat: no side is up
                    roll = None
                else:
                    ang = math.degrees(math.atan2(x, y)) % 360  # screen axes: x right, y up; 0 is upright portrait
                    if min((ang - self.theta) % 360, (self.theta - ang) % 360) > 60:
                        self.theta = round(ang / 90) % 4 * 90
                    roll = (ang - self.theta + 180) % 360 - 180
                GLib.idle_add(self.set_roll, roll)
            p.kill()
            p.wait()
            time.sleep(1)

    def set_roll(self, roll):
        self.roll = roll
        level = roll if self.S["level"] and roll is not None else None
        if level != self.finder.level:
            self.finder.level = level
            self.finder.queue_draw()
        if self.landscape and self.ui_theta != self.theta and self.theta in (90, 270):
            self.orient()
        elif self.retro and not self.rec and self.rturn != (self.cam[2] + (-self.theta if self.cam[0] == "back" else self.theta)) % 360:
            self.orient()

    # ---- frame analysis: exposure tools and autofocus, off the UI thread

    def set_lens(self, pos):
        if not self.has_lens:
            return
        try:
            with open(LENS, "w") as f:
                f.write(str(int(pos)))
            if pos >= 0:
                self.lens_pos = int(pos)
        except OSError:
            self.has_lens = False

    def analyse(self):
        last, n = 0.0, 0
        while not self.quit:
            now = time.monotonic()
            every = .5 if self.rec else .12  # the encoder needs the cores while recording
            if not (self.af or self.af_req) and now - last < every:
                time.sleep(.02)
                continue
            data = None
            with self.tap_lock:  # the frame is copied out and given back before anything slow
                sample = self.tap.emit("try-pull-sample", 50 * Gst.MSECOND) if self.tap else None
                if sample:
                    st = sample.get_caps().get_structure(0)
                    w, h, fmt = st.get_value("width"), st.get_value("height"), st.get_value("format")
                    buf = sample.get_buffer()
                    ok, info = buf.map(Gst.MapFlags.READ)
                    if ok:
                        data = bytes(info.data)
                        buf.unmap(info)
                    del sample, buf
                    self.frame = data and (data, w, h, fmt)
            if data is None:
                time.sleep(.05)
                continue
            arr = np.frombuffer(data, np.uint8)[:h * (len(data) // h)].reshape(h, len(data) // h)[:, :w * 4].reshape(h, w, 4)
            if fmt.startswith("BGR"):
                arr = arr[:, :, [2, 1, 0, 3]]
            if now - self.qr_last >= QR_EVERY and self.qr_wanted():
                self.qr_last = now
                small = cv2.resize(arr, (QR_WIDTH, QR_WIDTH * h // w), interpolation=cv2.INTER_AREA)
                gray = cv2.cvtColor(small, cv2.COLOR_RGBA2GRAY)  # R and B only swap weights, which is fine for a code
                self.qr_in = cv2.flip(gray, 1) if self.cam[3] else gray  # the front camera's preview is mirrored
                self.qr_ev.set()
            if self.lens_ok():
                self.focus_step(arr, now)
            if now - last >= every:
                last, n = now, n + 1
                GLib.idle_add(self.assist, *self.tools(arr, n))

    # ---- QR codes: scanned off the UI thread on a small grey copy, shown as a pill, acted on only by a tap

    def qr_wanted(self):
        return bool(self.S["qr"] and self.S["mode"] == "pro" and self.tap and not (self.busy or self.rec or self.asleep
                    or self.paused or self.closing or self.count_id))

    def qr_worker(self):
        try:
            os.setpriority(os.PRIO_PROCESS, threading.get_native_id(), 10)  # the viewfinder and the shutter come first
        except OSError:
            pass
        det = cv2.QRCodeDetector()
        while not self.quit:
            self.qr_ev.wait()
            self.qr_ev.clear()
            gray, self.qr_in = self.qr_in, None
            if gray is None or not self.qr_wanted():
                continue
            try:
                text = det.detectAndDecode(gray)[0]
            except cv2.error:
                text = ""
            if text:
                GLib.idle_add(self.qr_found, text)

    def qr_found(self, text):
        self.qr_seen = time.monotonic()
        if self.qr_card_open() or not self.qr_wanted():
            return False
        if text != self.qr_text:
            self.qr_text, self.qr_info = text, lib.qr_describe(text)
            self.qrpill.set_child(Gtk.Label(label=self.qr_info["label"], ellipsize=Pango.EllipsizeMode.END, max_width_chars=30))
        self.qrpill.set_visible(True)
        return False

    def qr_tick(self):
        """the pill goes a moment after the code left the frame, or when scanning no longer applies"""
        if self.qrpill.get_visible() and (not self.qr_wanted() or time.monotonic() - self.qr_seen > QR_GONE):
            self.qrpill.set_visible(False)
            self.qr_text = None
        return not self.quit

    def qr_card_open(self):
        return self.qrcard.get_visible()

    def qr_close(self, *_):
        self.qrcard.set_visible(False)
        self.qr_text = None
        self.qrpill.set_visible(False)

    def qr_card(self, title, body, buttons):
        c = self.qrcard.get_first_child()
        while c:
            nxt = c.get_next_sibling()
            self.qrcard.remove(c)
            c = nxt
        self.qrcard.append(Gtk.Label(label=title, css_classes=["rtitle"], xalign=0))
        self.qrcard.append(Gtk.Label(label=body, css_classes=["qrbody"], xalign=0, wrap=True, wrap_mode=Pango.WrapMode.WORD_CHAR,
                                     max_width_chars=32, selectable=False))
        buttons = buttons + [("CLOSE", self.qr_close, False)]
        tall = any(len(b[0]) > 8 for b in buttons)  # long labels stack instead of running off the screen
        row = Gtk.Box(orientation=Gtk.Orientation.VERTICAL if tall else Gtk.Orientation.HORIZONTAL, spacing=8, homogeneous=True)
        for label, fn, main in buttons:
            b = Gtk.Button(label=label, css_classes=["qrbtn", "main"] if main else ["qrbtn"], name=label)
            b.connect("clicked", lambda _b, fn=fn: fn())
            row.append(b)
        self.qrcard.append(row)
        self.qrpill.set_visible(False)
        self.qrcard.set_visible(True)

    def qr_tapped(self, *_):
        q = self.qr_info
        if not q:
            return
        if q["kind"] == "url":
            if q["confirm"]:  # the pill cut the host or it looks like a disguise: the whole address first
                self.qr_card("OPEN THIS LINK?", q["text"], [("OPEN", lambda: self.qr_open(q["text"]), True),
                                                           ("COPY", lambda: self.qr_copy(q["text"]), False)])
            else:
                self.qr_open(q["text"])
        elif q["kind"] == "wifi":
            pw = "" if q["open"] else q["password"]
            body = q["ssid"] + ("\nNo password" if q["open"] else "\nPassword: " + pw)
            btns = [("JOIN", lambda: self.qr_join(q), True)]
            if pw:
                btns.append(("COPY PASSWORD", lambda: self.qr_copy(pw), False))
            self.qr_card("WI-FI NETWORK", body, btns)
        else:
            self.qr_card(q["label"].upper(), q["text"], [("COPY", lambda: self.qr_copy(q["text"]), True)])

    def qr_log(self, line):
        if QR_DRY:
            with open(QR_DRY, "a") as f:
                f.write(line + "\n")
        return bool(QR_DRY)

    def qr_open(self, url):
        self.qr_close()
        if not self.qr_log("open " + url):
            subprocess.Popen(["xdg-open", url], start_new_session=True, stdin=subprocess.DEVNULL,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def qr_copy(self, text):
        self.qr_close()
        if not self.qr_log("copy " + text):
            try:
                p = subprocess.Popen(["wl-copy"], stdin=subprocess.PIPE, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                p.stdin.write(text.encode())
                p.stdin.close()
                self.show_msg("Copied")
            except OSError:
                self.show_msg("Could not copy")
            GLib.timeout_add(1200, lambda: self.show_msg("") and False)

    def qr_join(self, q):
        self.qr_close()
        if self.qr_log("join " + q["ssid"] + " " + ("open" if q["open"] else "secret")):
            return
        if q["ssid"].startswith("-") or not shutil.which("nmcli"):
            return self.show_msg("Could not join\n" + ("Unusable network name" if shutil.which("nmcli") else "NetworkManager is missing"))
        self.show_msg("Joining " + q["ssid"] + "...")

        def run():
            cmd = ["nmcli", "-w", "30"] + ([] if q["open"] else ["--ask"]) + ["dev", "wifi", "connect", q["ssid"]]
            if q["hidden"]:
                cmd += ["hidden", "yes"]
            try:
                r = subprocess.run(cmd, input=None if q["open"] else q["password"] + "\n", capture_output=True, text=True, timeout=40)
                ok, why = r.returncode == 0, (r.stderr.strip().splitlines() or ["The network did not accept the connection."])[0]
            except (OSError, subprocess.TimeoutExpired):
                ok, why = False, "Timed out"
            GLib.idle_add(lambda: (self.show_msg("Joined " + q["ssid"] if ok else "Could not join\n" + why),
                                   GLib.timeout_add(2500, lambda: self.show_msg("") and False), False)[2])
        threading.Thread(target=run, daemon=True).start()

    def sharpness(self, arr):
        """edge energy around the focus point, scaled by brightness so exposure changes do not read as blur"""
        h, w = arr.shape[:2]
        u, v = self.meter or (.5, .5)
        r = min(h, w) // 5
        cx, cy = int(min(max(u * w, r), w - r)), int(min(max(v * h, r), h - r))
        g = cv2.GaussianBlur(np.ascontiguousarray(arr[cy - r:cy + r, cx - r:cx + r, 1]), (0, 0), 1.0).astype(np.float32)
        return float((cv2.Sobel(g, cv2.CV_32F, 1, 0) ** 2 + cv2.Sobel(g, cv2.CV_32F, 0, 1) ** 2).mean() / (g.mean() + 4) ** 2)

    def focus_step(self, arr, now):
        """one frame of autofocus; runs on the analysis thread"""
        if not (self.S["focus"] is None or not self.manual):
            self.af = None
            return
        if self.af_req:  # near the last good focus first, the whole range when there is none
            self.af_req, self.af_wait, self.af_t = False, 2, now
            self.af = lib.AFSearch(LENS_LO, LENS_HI, self.lens_pos if self.af_good is not None else None)
            self.af_log = []
            self.set_lens(self.af.pos)
            return
        # a hand moving the phone changes sharpness more than the lens does: no search while it moves.
        # Compared as a handful of block means, which a change of focus leaves alone.
        coarse = cv2.resize(arr[::8, ::8, 1], (8, 6), interpolation=cv2.INTER_AREA).astype(np.int16)
        moving = self.af_coarse is not None and float(np.abs(coarse - self.af_coarse).mean()) > 3
        self.af_coarse = coarse
        self.af_calm = 0 if moving else self.af_calm + 1
        if self.af and moving:
            self.af, self.af_again = None, True
            self.set_lens(LENS_REST if self.af_good is None else self.af_good)
            return
        if self.af_again and self.af_calm >= 6:
            self.af_again, self.af_req = False, True
            return
        sharp = self.sharpness(arr)
        if self.af:
            if self.af_wait:  # the lens and the frames in flight settle
                self.af_wait -= 1
                return
            self.af_log.append(f"{self.af.pos}:{sharp:.4g}")
            af, self.af_wait = self.af, 2
            if af.feed(sharp) is None:
                if not af.sure:  # nothing to focus on: the position that is sharp from a metre out
                    af.pos = LENS_REST
                self.af_good = af.pos
                self.af, self.af_ref, self.af_seen, self.af_t = None, None, [], now
                self.note(f"af {'sure' if af.sure else 'flat'} -> {af.pos} | " + " ".join(self.af_log))
                GLib.idle_add(self.focused)
            self.set_lens(af.pos)
        elif now - self.af_t > .4:
            if self.af_ref is None:
                self.af_ref = sharp
            # continuous: refocus once the picture has changed and then held still again
            self.af_seen = (self.af_seen + [sharp])[-4:]
            mean = sum(self.af_seen) / len(self.af_seen)
            still = len(self.af_seen) == 4 and max(self.af_seen) - min(self.af_seen) < .2 * mean and self.af_calm >= 4
            if still and abs(mean - self.af_ref) > .35 * self.af_ref and now - self.af_t > 2.5 and not self.busy:
                self.af_req = True

    def note(self, text):
        """focus diary in the cache: how the lens answers on real scenes"""
        try:
            path = os.path.join(GLib.get_user_cache_dir(), "phonecam-focus.log")
            mode = "a" if os.path.exists(path) and os.path.getsize(path) < 200000 else "w"
            with open(path, mode) as f:
                f.write(time.strftime("%F %T ") + text + "\n")
        except OSError:
            pass

    def focused(self):
        self.finder.ring_ok = True
        self.finder.queue_draw()
        if "focus" in self.tiles:
            self.update_tile("focus")

    def tools(self, arr, n):
        """histogram, clipping and the overlay picture (zebra, peaking, false colour) at 1/4 scale"""
        S = self.S
        y = cv2.cvtColor(np.ascontiguousarray(arr[::4, ::4, :3]), cv2.COLOR_RGB2GRAY)
        hist = np.bincount(y.ravel() >> 2, minlength=64)
        self.rgb = tuple(float(v) + 1 for v in arr[::16, ::16, :3].reshape(-1, 3).mean(0))
        clip = (float((y <= 3).mean()), float((y >= 250).mean()))
        ov = None
        if self.manual and (S["zebra"] or S["falsecolor"] or S["peaking"] or self.param == "focus"):
            ov = np.zeros(y.shape + (4,), np.uint8)
            if S["falsecolor"]:
                lut = np.zeros((256, 4), np.uint8)
                lo = 0
                for top, rgb in FALSE:
                    hi = min(256, math.ceil(top * 2.55))
                    lut[lo:hi, :3] = rgb if rgb else np.arange(lo, hi)[:, None]
                    lo = hi
                lut[:, 3] = 255
                ov = lut[y]
            elif S["zebra"]:
                yy, xx = np.indices(y.shape)
                stripe = ((xx + yy + n) // 3) % 2 == 0
                hot = y >= S["zebra"] * 2.55
                ov[hot & stripe] = (255, 255, 255, 255)
                ov[hot & ~stripe] = (0, 0, 0, 255)
            if S["peaking"] or self.param == "focus":
                g = np.ascontiguousarray(arr[::2, ::2, 1])
                edge = np.abs(cv2.Laplacian(cv2.GaussianBlur(g, (0, 0), .8), cv2.CV_16S, ksize=3)) > 28 + max(0, 70 - int(y.mean()))  # in the dark the noise would light up as a red checkerboard
                eh, ew = y.shape
                ov[edge[:eh * 2, :ew * 2].reshape(eh, 2, ew, 2).any(axis=(1, 3))] = (215, 25, 33, 255)
        return hist, clip, ov

    def assist(self, hist, clip, ov):
        self.hist, self.clip = hist, clip
        if self.scope.get_visible():
            self.scope.queue_draw()
        tex = None
        if ov is not None:
            h, w = ov.shape[:2]
            tex = Gdk.MemoryTexture.new(w, h, Gdk.MemoryFormat.R8G8B8A8, GLib.Bytes.new(ov.tobytes()), w * 4)
        if tex or self.finder.overlay:
            self.finder.overlay = tex
            self.finder.queue_draw()

    def poll_sensor(self):
        """what the automatic exposure chose, for the tiles and for locking"""
        while not self.quit:
            time.sleep(1)
            if TESTSRC or not self.pipe or self.busy or not self.manual:
                continue
            try:
                out = subprocess.run([os.path.join(BIN, "phonecam-raw"), "--viewfinder", self.cam[0]], check=True,
                                     capture_output=True, text=True).stdout.split()
                self.live = (float(out[0]), float(out[1]))
                GLib.idle_add(lambda: [self.update_tile(k) for k in self.tiles] and False)
            except (subprocess.CalledProcessError, ValueError, IndexError, OSError):
                pass

    def tick(self):
        """once a second: recording clock, idle release of the sensor"""
        if os.environ.get("PHONECAM_DEBUG"):
            print("fps", getattr(self, "drawn", 0), "qr", self.qr_wanted(), file=sys.stderr, flush=True)
            self.drawn = 0
        if self.rec:
            self.update_status()
        elif self.pipe and not self.busy and not self.count_id and time.monotonic() - self.touched > IDLE_S:
            self.release()
            self.paused = True
            self.show_msg("Paused\nTap to resume")
        return not self.quit

    # ---- video

    def microphone(self):
        """the default input, if the phone has one that is not a loopback of its own speaker"""
        try:
            out = subprocess.run(["pactl", "list", "short", "sources"], capture_output=True, text=True, timeout=3).stdout
        except (OSError, subprocess.TimeoutExpired):
            return None
        names = [l.split("\t")[1] for l in out.splitlines() if "\t" in l and not l.split("\t")[1].endswith(".monitor")]
        return names[0] if names else None

    def on_element(self, _bus, m):
        s = m.get_structure()
        if s and s.get_name() == "level":
            self.audio = max(s.get_value("peak"))
            self.scope.queue_draw()

    def on_drop(self, *_):
        if self.rec:
            self.rec["drops"] += 1

    def record_ui(self, on):
        self.shutter_art.queue_draw()
        for wdg in (self.flip, self.gear, self.thumb):
            wdg.set_sensitive(not on and (wdg is not self.thumb or bool(self.last)))
        if not on:
            self.audio = None
        self.update_status()

    def record(self):
        os.makedirs(VIDS, exist_ok=True)
        if shutil.disk_usage(VIDS).free < 200e6:
            return self.shot_failed("Storage full")
        path = output_name(time.time(), self.S["anon"], "VID", "mp4")
        self.sheet_open(False)
        if self.S["lock"] and not self.locked and not TESTSRC and not self.retro:
            self.show_msg("Locking exposure")
            self.shutter.set_sensitive(False)
            return threading.Thread(target=self.lock, daemon=True).start()
        mic = self.start(record=path)
        if not self.pipe:
            self.locked = None
            return
        self.rec = dict(path=path, t0=time.monotonic(), drops=0, mic=bool(mic))
        self.record_ui(True)

    def lock(self):
        """worker thread: freeze what the automatics chose. The ISP has no "hold" for white balance
        (off means unity gains), so find the gains that keep grey grey, as its grey-world AWB does."""
        try:
            out = subprocess.run([os.path.join(BIN, "phonecam-raw"), "--viewfinder", self.cam[0]], check=True,
                                 capture_output=True, text=True).stdout.split()
            exp, gain = float(out[0]), float(out[1])
        except (subprocess.CalledProcessError, ValueError, IndexError, OSError):
            exp, gain = self.live
        g = [1.5, 1.8]
        if self.S["wb"]:
            g = list(lib.kelvin_gains(self.S["wb"], self.S["tint"]))
        else:
            for _ in range(6):
                self.locked = (exp, gain, tuple(g))
                GLib.idle_add(self.push_controls)
                time.sleep(.45)
                r, gm, b = self.rgb
                if abs(r / gm - 1) < .03 and abs(b / gm - 1) < .03:
                    break
                # the picture is gamma encoded: a channel 10% low needs about 25% more gain
                g = [min(max(g[0] * (gm / r) ** 1.8, 1.0), 3.99), min(max(g[1] * (gm / b) ** 1.8, 1.0), 3.99)]
        self.locked = (exp, gain, tuple(g))
        GLib.idle_add(lambda: self.shutter.set_sensitive(True) or self.record())

    def stop_record(self):
        if self.rec.get("stopping"):
            return
        self.rec["stopping"] = True
        self.shutter.set_sensitive(False)
        self.pipe.send_event(Gst.Event.new_eos())
        GLib.timeout_add(5000, lambda: self.rec and self.recorded() and False)

    def recorded(self):
        """the file is closed: back to the plain viewfinder"""
        rec, self.rec, self.locked = self.rec, None, None
        if not rec:
            return
        if self.S["anon"] and os.path.exists(rec["path"]):
            lib.strip_mp4(rec["path"])
        snap = self.still()
        self.shutter.set_sensitive(True)
        self.record_ui(False)
        if self.closing:
            if not self.pending and not self.busy:
                self.shutdown()
                self.destroy()
            return
        if self.asleep:
            self.release()
        else:
            self.start()
        if os.path.exists(rec["path"]) and os.path.getsize(rec["path"]) > 1000:
            self.last = rec["path"]
            if snap:
                self.show_thumb(snap, self.finder.rot, self.finder.mirror)
            self.thumb.set_sensitive(True)
            print(rec["path"], flush=True)
        else:
            self.shot_failed("Recording failed")

    # ---- photo

    def shutter_clicked(self, *_):
        self.touched = time.monotonic()
        if self.paused:
            return self.start()
        if self.filming:
            return self.stop_record() if self.rec else self.record()
        if self.count_id:  # a second press cancels the timer
            GLib.source_remove(self.count_id)
            self.count_id = self.finder.count = 0
            return self.finder.queue_draw()
        if self.pending >= 3 or self.S["timer"] and (self.busy or not self.pipe):
            return
        if self.busy or not self.pipe:  # pressed while the sensor is busy: show it was taken, shoot as soon as the viewfinder is back
            self.queued = True
            self.flash.add_css_class("on")
            GLib.timeout_add(70, lambda: self.flash.remove_css_class("on") or False)
            return
        if self.S["timer"]:
            self.finder.count = self.S["timer"]
            self.count_id = GLib.timeout_add(1000, self.countdown)
            return self.finder.queue_draw()
        self.capture()

    def fire_queued(self, since):
        if self.closing or self.asleep or self.rec:
            return False
        if self.pipe and not self.busy and time.monotonic() - self.started > .7:  # the viewfinder has settled
            self.capture()
            return False
        return time.monotonic() - since < 3  # give up after three seconds

    def countdown(self):
        self.finder.count -= 1
        self.finder.queue_draw()
        if self.finder.count:
            return True
        self.count_id = 0
        self.capture()
        return False

    def capture(self):
        S = self.S
        name, _p, rot, _mirror, modes = self.cam
        _, mode, frames, size = modes[min(S["size"], len(modes) - 1)]
        zoom = self.finder.zoom
        if zoom > 1:  # zoomed shots are 12 MP or the sensor's native size; 2x and up crop the full-res readout
            if name == "back" and zoom >= 1.9:
                mode, frames = "full", 3
            size = modes[0][3]
        turn = (rot - self.theta if name == "back" else rot + self.theta) % 360  # the way the phone is held now
        dev = ["--zoom", f"{zoom:g}", "--size", str(size), "--rot", str(turn)]
        if self.meter:
            dev += ["--meter", "%.4f,%.4f" % self.meter]
        if self.retro:  # 12 MP in, the old camera's few pixels out
            mode, frames = modes[0][1:3]
            dev = ["--zoom", f"{zoom:g}", "--size", str(modes[0][3]), "--rot", str(turn), "--retro", S["rstyle"],
                   "--retro-size", str(retro.SIZES[S["rsize"]]),
                   "--retro-adj", ",".join(f"{v:g}" for v in self.radj().values())] + (["--stamp", f"{time.time():.0f}"] if S["stamp"] else [])
        elif FILTERS[S["filter"]][1]:
            dev += ["--matrix", ",".join(f"{v:.5f}" for r in FILTERS[S["filter"]][1] for v in r)]
        if S["aspect"] != "4:3" and not self.retro:
            dev += ["--aspect", f"{dict(lib.ASPECTS)[S['aspect']]:.4f}"]
        man = (None, None)
        if S["mode"] == "pro":
            man = (S["shutter"], S["iso"])
            if S["wb"]:
                dev += ["--wb", "%.4f,%.4f" % lib.kelvin_gains(S["wb"], S["tint"])]
            if S["ev"]:
                dev += ["--ev", f"{S['ev']:.3f}"]
            if all(man):  # fully manual: the photo is as bright as the settings make it
                dev += ["--gain", "1"]
        self.busy = True
        for w in (self.flip, self.gear):  # the shutter stays live: a press now queues the next shot
            w.set_sensitive(False)
        self.shutter.add_css_class("snap")
        self.flash.add_css_class("on")
        GLib.timeout_add(70, lambda: self.flash.remove_css_class("on") or self.shutter.remove_css_class("snap"))
        # the frame on screen now is the instant thumbnail and stays up while the sensor is busy
        snap = self.still()
        if snap:
            self.show_thumb(snap, self.finder.rot, self.finder.mirror)
        self.finder.set_paintable(snap)
        os.makedirs(PICS, exist_ok=True)
        path = output_name(time.time(), self.S["anon"])
        SHOT_T[path] = time.monotonic()
        threading.Thread(target=self.grab, args=(name, mode, frames, path, dev, man,
                                                 S["flash"] == "FLASH" or self.retro and bool(retro.STYLES[S["rstyle"]].get("flash"))
                                                 and S["flash"] != "TORCH" and name == "back",
                                                 S["stack"], S["dng"] and not self.retro, S["mode"] == "pro" and S["ev"] or 0.0), daemon=True).start()

    def grab(self, name, mode, frames, path, dev, man, flash, stack, dng, ev):
        """worker thread: viewfinder exposure, raw frames to disk, viewfinder back, develop queued"""
        t0 = time.monotonic()
        while (self.af or self.af_req) and time.monotonic() - t0 < 2.5:  # let a focus sweep finish
            time.sleep(.05)
        if flash:
            self.set_led(True)
            time.sleep(.7)  # the automatic exposure takes the light in
        try:
            exp, gain = raw_tool().viewfinder(name)
        except (subprocess.CalledProcessError, ValueError, OSError, KeyError):
            exp, gain = 30000.0, 4.0
        exp, gain = man[0] or exp, man[1] or gain
        if not any(man):
            exp *= 2.0 ** min(ev, 0)  # negative compensation also protects the highlights in the raw data
            if exp > HANDHELD_US:
                gain, exp = gain * exp / HANDHELD_US, HANDHELD_US
        stack = stack == "STACKED" or (stack == "AUTO" and gain > DARK_GAIN)  # instant, or auto in daylight: one frame
        if not stack:
            frames = 1
        if gain > DARK_GAIN:
            if stack:
                frames *= 2
            if name == "back" and mode == "full":  # on-chip remosaic breaks into 2x2 blocks at low SNR: bin, then scale up
                mode, frames = "bin", 12 if stack else 1
                i = dev.index("--size") + 1
                dev = dev[:i] + [dev[i] if dev[i] != "0" else "8160"] + dev[i + 1:]
        lap(path, "exposure measured")
        dev = dev + ([] if self.S["anon"] else ["--exif", f"{exp:.0f},{gain * 100:.0f}", "--camera", name]) \
            + (["--dng", path[:-4] + ".dng"] + (["--anon", "1"] if self.S["anon"] else []) if dng else [])
        stopped = threading.Event()
        GLib.idle_add(lambda: self.stop() or stopped.set())
        stopped.wait()
        lap(path, "viewfinder stopped")
        raw = os.path.join(GLib.get_user_cache_dir(), os.path.basename(path) + ".raw")
        err = geo = None
        try:
            geo = [str(v) for v in raw_tool().capture(name, mode, frames, float(f"{exp:.0f}"), float(f"{gain:.3f}"), raw)]
        except subprocess.CalledProcessError as e:
            err = ((e.stderr or "").strip().splitlines()[-1:] or [str(e)])[0]
        except (OSError, SystemExit, subprocess.TimeoutExpired) as e:
            err = str(e)
        if flash:
            self.set_led(False)
        lap(path, "raw captured")
        GLib.idle_add(self.grabbed, raw, geo, path, frames, dev, err)

    def grabbed(self, raw, geo, path, frames, dev, err):
        self.busy = False
        lap(path, "ready for the next shot")
        for w in (self.flip, self.gear):
            w.set_sensitive(True)
        if self.asleep:
            self.release()
        elif not self.closing:
            self.start()
            if self.queued:
                self.queued = False
                GLib.timeout_add(100, self.fire_queued, time.monotonic())
        if err:
            if os.path.exists(raw):
                os.unlink(raw)
            self.shot_failed(err)
            if self.closing and not self.pending:
                self.destroy()
            return
        self.pending += 1
        self.ring.queue_draw()
        self.jobs.put((raw, geo, path, frames, dev))

    def developer(self):
        """one develop at a time, at low priority so the viewfinder stays smooth"""
        while True:
            raw, (w, h, stride, _rot, bayer, ccm), path, frames, dev = self.jobs.get()
            err = None
            try:
                p = subprocess.Popen((["nice", "-n", "10"] if frames > 1 else []) + [os.path.join(BIN, "phonecam-develop"), raw, w, h, stride,
                                      path + ".part.jpg", "--frames", str(frames), "--bayer", bayer,
                                      "--ccm", ccm, *dev], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
                for line in p.stdout:
                    try:
                        GLib.idle_add(self.set_progress, float(line))
                    except ValueError:
                        pass
                errs = p.stderr.read()
                if p.wait():
                    err = (errs.strip().splitlines()[-1:] or [f"develop exited {p.returncode}"])[0]
                else:
                    os.replace(path + ".part.jpg", path)
            except OSError as e:
                err = str(e)
            finally:
                for f in (raw, path + ".part.jpg"):
                    if os.path.exists(f):
                        os.unlink(f)
            GLib.idle_add(self.developed, None if err else path, err)

    def set_progress(self, f):
        self.progress = f
        self.ring.queue_draw()

    def developed(self, path, err):
        self.pending -= 1
        self.progress = 0.0
        self.ring.queue_draw()
        if err:
            self.shot_failed(err)
        else:
            self.last = path
            self.set_thumb(path)
            print(path, flush=True)
            if os.environ.get("PHONECAM_DEBUG") and path in SHOT_T:
                print("shutter-to-file %.2fs" % (time.monotonic() - SHOT_T.pop(path)), file=sys.stderr, flush=True)
        if self.closing and not self.pending and not self.busy:
            self.shutdown()
            self.destroy()

    def shot_failed(self, err):
        self.show_msg(f"Capture failed\n{err}")
        GLib.timeout_add(4000, lambda: self.show_msg(""))

    def shutdown(self):
        """nothing keeps running or powered once the window is gone"""
        self.quit = True
        self.stop()
        self.set_lens(-1)
        self.set_led(False)
        ssc = getattr(self, "ssc", None)
        if ssc:
            ssc.kill()

    def on_suspended(self, *_):
        """screen off, locked or covered: the sensor and the software ISP stop (they are the phone's
        biggest heater), a recording is closed properly first; back in view, the viewfinder returns"""
        self.asleep = self.props.suspended
        self.claim_keys()
        if os.environ.get("PHONECAM_DEBUG"):
            print("suspended", self.asleep, file=sys.stderr, flush=True)
        if not self.asleep:
            if not self.pipe and not self.busy and not self.closing:
                self.touched = time.monotonic()
                self.start()
        elif self.rec:
            self.stop_record()  # recorded() sees asleep and leaves the camera off
        elif not self.busy:  # a photo being grabbed finishes; grabbed() then leaves the camera off
            self.release()

    def release(self):
        self.stop()
        self.set_lens(-1)
        self.set_led(False)

    def claim_keys(self):
        """tell the shell whether this window takes the volume keys now (it then leaves the volume alone).
        shortcut: a camera that crashed in front leaves the claim behind until the next camera starts or closes"""
        want = self.S["volkeys"] and self.props.is_active and not self.asleep and not self.closing
        try:
            with open(os.path.join(STATE, "camera-keys"), "w") as f:
                f.write("1\n" if want else "0\n")
        except OSError:
            pass
        return want

    def on_button(self, *_):
        try:
            with open(os.path.join(STATE, "button")) as f:
                seq, _, event = f.read().strip().partition(" ")
        except OSError:
            return
        first, self.btn_seq = self.btn_seq is None, seq
        now = time.monotonic()
        if first or event not in ("volup", "voldown") or not self.claim_keys() or now - self.btn_t < .35:
            return  # a held key repeats: one press, one picture
        self.btn_t = now
        if self.retro and self.S["haptic"]:
            BUZZ.play(45 if event == "volup" else 18)
        if event == "volup":
            self.shutter_clicked()
        elif self.S["mode"] != "video":
            self.set_zoom({1: 2, 2: 4}.get(round(self.finder.zoom), 1))

    def on_close(self, *_):
        """photos still in the queue get finished with the window hidden"""
        if self.rec:  # the file is only playable once it is closed properly
            self.closing = True
            self.stop_record()
            self.set_visible(False)
            return True
        self.stop()
        self.set_lens(-1)
        self.set_led(False)
        self.save()
        if self.pending or self.busy:
            self.closing = True
            self.set_visible(False)
            return True
        self.shutdown()
        return False

    def set_thumb(self, path):
        try:
            pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, 104, 104, True)
            self.show_thumb(Gdk.Texture.new_for_pixbuf(pb))
        except GLib.Error:
            pass
        self.thumb.set_sensitive(True)

    def open_last(self, *_):
        if not self.last:
            return
        try:
            Gio.Subprocess.new(["phonegallery", self.last], Gio.SubprocessFlags.NONE)
        except GLib.Error:  # no gallery installed
            Gio.AppInfo.launch_default_for_uri(GLib.filename_to_uri(self.last), None)


SHOT_T = {}  # output path -> shutter press time, for the debug timing line
_RAW = []


def raw_tool():
    """phonecam-raw loaded once, so a shot does not pay for two interpreter starts"""
    if not _RAW:
        from importlib.machinery import SourceFileLoader
        _RAW.append(SourceFileLoader("phonecam_raw", os.path.join(BIN, "phonecam-raw")).load_module())
    return _RAW[0]


def lap(path, what):
    if os.environ.get("PHONECAM_DEBUG") and path in SHOT_T:
        print("  %.2fs %s" % (time.monotonic() - SHOT_T[path], what), file=sys.stderr, flush=True)


def output_name(t, anon=False, kind="IMG", ext="jpg"):
    """the time is in the name, unless the shot is anonymous: then it is random, and the name says nothing"""
    stamp = os.urandom(6).hex() if anon else time.strftime("%Y%m%d_%H%M%S", time.localtime(t))
    return os.path.join(PICS, f"{kind}_{stamp}.{ext}")


def main():
    app = Gtk.Application(application_id="org.phonegluewc.Camera", flags=Gio.ApplicationFlags.NON_UNIQUE)

    def activate(a):
        prov = Gtk.CssProvider()
        prov.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), prov, 800)
        Cam(a).present()

    app.connect("activate", activate)
    return app.run([sys.argv[0]])


if __name__ == "__main__":
    assert "/Camera/IMG_1970010" in output_name(0)
    assert set(DEFAULTS) >= {r[0] for r in ROWS} and all(len(v) == 7 and max(v) < 32 for v in FONT.values())
    sys.exit(main())
