class DotText(Gtk.DrawingArea):
    def __init__(self, text="", pitch=2.0, rgb=(1, 1, 1), **kw):
        super().__init__(content_height=math.ceil(7 * pitch), valign=Gtk.Align.CENTER, **kw)
        self.pitch, self.rgb, self.text = pitch, rgb, None
        self.set_draw_func(lambda _a, cr, w, h: dots(cr, self.text, 0, 0, self.pitch, self.rgb))
        self.set(text)

    def set(self, text, rgb=None):
        if (text, rgb or self.rgb) != (self.text, self.rgb):
            self.text, self.rgb = text, rgb or self.rgb
            self.set_content_width(math.ceil(len(text) * 6 * self.pitch))
            self.queue_draw()


class Ruler(Gtk.DrawingArea):
    """a dotted scale dragged under a fixed marker; items are (label, value), every major-th gets its label"""

    def __init__(self, changed, done):
        super().__init__(hexpand=True, content_height=52)
        self.items, self.i, self.pos, self.major, self.step, self.changed, self.done = [], 0, 0.0, 3, 13, changed, done
        self.set_draw_func(self.draw)
        drag = Gtk.GestureDrag()
        drag.connect("drag-begin", lambda *_: setattr(self, "p0", self.pos))
        drag.connect("drag-update", self.dragged)
        drag.connect("drag-end", lambda *_: (setattr(self, "pos", float(self.i)), self.queue_draw(), self.done()))
        self.add_controller(drag)
        wheel = Gtk.EventControllerScroll(flags=Gtk.EventControllerScrollFlags.BOTH_AXES)
        wheel.connect("scroll", lambda _c, dx, dy: self.step_by(1 if dx + dy > 0 else -1) or True)
        self.add_controller(wheel)

    def step_by(self, n):
        i = min(max(self.i + n, 0), len(self.items) - 1)
        if i != self.i:
            self.i, self.pos = i, float(i)
            self.changed(self.items[i][1])
            self.queue_draw()
            self.done()

    def load(self, items, value, major):
        self.items, self.major, self.step = items, major, 13 if len(items) > 12 else 36
        self.i = min(range(len(items)), key=lambda j: abs(items[j][1] - value)) if value is not None else len(items) // 2
        self.pos = float(self.i)
        self.queue_draw()

    def dragged(self, _g, dx, _dy):
        self.pos = min(max(self.p0 - dx / self.step, 0), len(self.items) - 1)
        if round(self.pos) != self.i:
            self.i = round(self.pos)
            self.changed(self.items[self.i][1])
        self.queue_draw()

    def draw(self, _a, cr, w, h):
        cx = w / 2
        cr.select_font_face("Adwaita Mono")
        cr.set_font_size(10)
        for j, (label, _v) in enumerate(self.items):
            x = cx + (j - self.pos) * self.step
            if not -20 < x < w + 20:
                continue
            near = max(0.25, 1 - abs(x - cx) / (w / 2))
            cr.set_source_rgba(1, 1, 1, near)
            if j % self.major == 0:
                cr.rectangle(x - 1, 8, 2, 14)
                cr.fill()
                ext = cr.text_extents(label)
                cr.move_to(x - ext.width / 2, 40)
                cr.show_text(label)
            else:
                cr.arc(x, 15, 1.5, 0, 6.2832)
                cr.fill()
        cr.set_source_rgb(*RED)
        cr.rectangle(cx - 1.5, 2, 3, 24)
        cr.fill()


class Finder(Gtk.Widget):
    """the viewfinder: the camera picture turned upright, zoomed about the centre, tinted by a filter;
    exposure overlays in sensor space; frame lines, grid, level, focus ring and countdown on top"""

    def __init__(self):
        super().__init__(hexpand=True, vexpand=True)
        self.paintable, self.hid, self.zoom, self.matrix = None, None, 1.0, None
        self.rot, self.mirror, self.overlay = 270, False, None
        self.ring, self.ring_ok, self.aspect, self.grid, self.level = None, True, 0.0, False, None
        self.count, self.legend, self.inset = 0, False, 0
        self.pre = None  # (turn, mirror) already done to the picture before it got here; zoom too
        self.osd = None  # retro: what the old camera prints on its screen

    def set_paintable(self, p):
        if self.hid:
            self.paintable.disconnect(self.hid)
        self.paintable, self.hid = p, p and p.connect("invalidate-contents", lambda *_: self.queue_draw())
        self.queue_draw()

    def rect(self):
        w, h = max(self.get_width(), 1), max(self.get_height(), 1)
        a = self.paintable.get_intrinsic_aspect_ratio() if self.paintable else 0
        a = a or 4 / 3
        if self.rot in (90, 270):
            a = 1 / a
        dw, dh = (w, w / a) if w / h < a else (h * a, h)
        # under the top bar when there is room for that
        return (w - dw) / 2, max((h - dh) / 2, min(self.inset, h - dh)), dw, dh

    def frame(self):
        """the part of the picture a photo keeps: rect() cut to the aspect"""
        x, y, dw, dh = self.rect()
        if not self.aspect:
            return x, y, dw, dh
        cw, ch = lib.crop_aspect(dw, dh, self.aspect)
        return x + (dw - cw) / 2, y + (dh - ch) / 2, cw, ch

    def to_sensor(self, x, y):
        """widget point -> 0..1 in the sensor frame, or None outside the picture"""
        fx, fy, dw, dh = self.rect()
        u, v = (x - fx) / dw, (y - fy) / dh
        if not (0 <= u <= 1 and 0 <= v <= 1):
            return None
        back = lambda u, v, rot: {0: (u, v), 90: (v, 1 - u), 180: (1 - u, 1 - v), 270: (1 - v, u)}[rot]
        rot, mirror = self.rot, self.mirror
        if self.pre:
            (u, v), (rot, mirror) = back(u, v, rot), self.pre
        u, v = .5 + (u - .5) / self.zoom, .5 + (v - .5) / self.zoom
        if mirror:
            u = 1 - u
        return back(u, v, rot)

    def set_filter(self, m):
        # GSK multiplies the colour as a row vector: the 4x4 is our 3x4 transposed, offsets apart
        self.matrix = m and (Graphene.Matrix().init_from_float(
            [m[j][i] if i < 3 and j < 3 else float(i == j == 3) for i in range(4) for j in range(4)]),
            Graphene.Vec4().init(m[0][3], m[1][3], m[2][3], 0))
        self.queue_draw()

    def do_snapshot(self, sn):
        w, h = self.get_width(), self.get_height()
        x, y, dw, dh = self.rect()
        if self.paintable:
            pw, ph = (dh, dw) if self.rot in (90, 270) else (dw, dh)
            sn.push_clip(Graphene.Rect().init(x, y, dw, dh))
            sn.save()
            sn.translate(Graphene.Point().init(x + dw / 2, y + dh / 2))
            z = 1 if self.pre else self.zoom
            sn.scale(-z if self.mirror else z, z)
            sn.rotate(self.rot)
            sn.translate(Graphene.Point().init(-pw / 2, -ph / 2))
            if self.matrix:
                sn.push_color_matrix(*self.matrix)
            self.paintable.snapshot(sn, pw, ph)
            if self.matrix:
                sn.pop()
            if self.overlay:
                sn.append_texture(self.overlay, Graphene.Rect().init(0, 0, pw, ph))
            sn.restore()
            sn.pop()
        cr = sn.append_cairo(Graphene.Rect().init(0, 0, w, h))
        fx, fy, fw, fh = self.frame()
        if self.aspect:  # what the photo drops goes dark, the kept frame gets corner marks
            cr.set_source_rgba(0, 0, 0, .62)
            cr.rectangle(x, y, dw, dh)
            cr.rectangle(fx, fy, fw, fh)
            cr.set_fill_rule(1)  # even-odd: the second rectangle is a hole
            cr.fill()
            cr.set_fill_rule(0)
            cr.set_source_rgba(1, 1, 1, .9)
            cr.set_line_width(1.5)
            for sx, sy in ((0, 0), (1, 0), (0, 1), (1, 1)):
                px, py, d = fx + sx * fw, fy + sy * fh, 14
                cr.move_to(px + (d if not sx else -d), py)
                cr.line_to(px, py)
                cr.line_to(px, py + (d if not sy else -d))
                cr.stroke()
        if self.grid:
            cr.set_source_rgba(1, 1, 1, .35)
            cr.set_line_width(1)
            for k in (1, 2):
                cr.move_to(fx + fw * k / 3, fy)
                cr.line_to(fx + fw * k / 3, fy + fh)
                cr.move_to(fx, fy + fh * k / 3)
                cr.line_to(fx + fw, fy + fh * k / 3)
            cr.stroke()
        if self.level is not None:  # the bar follows the horizon between two fixed marks
            cx, cy, flat = x + dw / 2, y + dh / 2, abs(self.level) < 1
            cr.set_line_width(2)
            cr.set_source_rgba(1, 1, 1, .9 if flat else .45)
            for s in (-1, 1):
                cr.move_to(cx + s * 70, cy)
                cr.line_to(cx + s * 52, cy)
            cr.stroke()
            a = 0 if flat else math.radians(self.level)
            cr.set_source_rgba(*(1, 1, 1) if flat else RED, 1)
            cr.move_to(cx - 46 * math.cos(a), cy - 46 * math.sin(a))
            cr.line_to(cx + 46 * math.cos(a), cy + 46 * math.sin(a))
            cr.stroke()
        if self.ring:
            cr.set_source_rgba(1, 1, 1, .95)
            cr.set_line_width(2.5 if self.ring_ok else 1.2)
            cr.arc(self.ring[0], self.ring[1], 34, 0, 6.2832)
            cr.stroke()
            if self.ring_ok:
                cr.arc(self.ring[0], self.ring[1], 3, 0, 6.2832)
                cr.fill()
        if self.legend:
            names = ("CLIP", "", "", "18%", "", "SKIN", "", "", "CLIP")
            seg = dw / len(FALSE)
            for n, (_top, rgb) in enumerate(FALSE):
                cr.set_source_rgb(*((c / 255 for c in rgb) if rgb else (.25 + n * .06,) * 3))
                cr.rectangle(x + n * seg, y + dh - 16, seg, 16)
                cr.fill()
                dots(cr, names[n], x + n * seg + 4, y + dh - 13, 1.4, (0, 0, 0) if rgb and n > 2 else (1, 1, 1))
        if self.osd and dw > 150:
            self.draw_osd(cr, x, y, dw, dh)
        if self.count:
            p = 9
            dots(cr, str(self.count), x + dw / 2 - len(str(self.count)) * 3 * p + p / 2, y + dh / 2 - 3.5 * p, p)


    def draw_osd(self, cr, x, y, w, h):
        """a compact camera's screen text: mode badge, battery, shots left, what is switched on"""
        o, p, m = self.osd, 1.7, 9

        def text(s, tx, ty, rgb=(1, 1, 1), right=False):
            tx -= len(s) * 6 * p if right else 0
            dots(cr, s, tx + 1.3, ty + 1.3, p, (0, 0, 0), .75)
            dots(cr, s, tx, ty, p, rgb)
            return len(s) * 6 * p
        line = 7 * p + 9
        bw = len(o["style"]) * 6 * p + 8
        cr.set_source_rgba(1, 1, 1, .95)
        cr.rectangle(x + m, y + m, bw, 7 * p + 8)
        cr.fill()
        dots(cr, o["style"], x + m + 5, y + m + 4, p, (0, 0, 0))
        text(o["cap"], x + m + bw + 8, y + m + 4)
        tw = text(o["left"], x + w - m, y + m + 4, right=True)
        bx, by = x + w - m - tw - 34, y + m + 3  # battery: outline, nub, three bars
        cr.set_source_rgb(1, 1, 1)
        cr.set_line_width(1.6)
        cr.rectangle(bx, by, 24, 12)
        cr.stroke()
        cr.rectangle(bx - 3, by + 3.5, 3, 5)
        for i in range(round(o["batt"] * 3)):
            cr.rectangle(bx + 18 - i * 7, by + 2.5, 4.5, 7)
        cr.fill()
        if o["zoom"]:
            text(o["zoom"], x + w - m, y + m + 4 + line, right=True)
        if o["rec"]:
            cr.set_source_rgb(*RED)
            cr.arc(x + m + 6, y + m + 4 + line + 3.5 * p, 5, 0, 6.2832)
            cr.fill()
            text(o["rec"], x + m + 18, y + m + 4 + line)
        if o["info"]:
            text(o["info"], x + m, y + h - m - 7 * p)
        text(o["date"], x + w - m, y + h - m - 7 * p, right=True)
        text(o["file"], x + w - m, y + m + 4 + line * (2 if o["zoom"] else 1), right=True)


