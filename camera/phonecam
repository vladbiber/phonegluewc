def dots(cr, text, x, y, pitch, rgb=(1, 1, 1), alpha=1.0):
    """5x7 dot-matrix text with its top left at x, y; returns the width drawn"""
    cr.set_source_rgba(*rgb, alpha)
    for n, ch in enumerate(text.upper()):
        for r, bits in enumerate(FONT.get(ch, FONT[" "])):
            for c in range(5):
                if bits >> (4 - c) & 1:
                    cr.new_sub_path()
                    cr.arc(x + (n * 6 + c + .5) * pitch, y + (r + .5) * pitch, pitch * .42, 0, 6.2832)
    cr.fill()
    return len(text) * 6 * pitch


class Buzz:
    """the phone's vibrator through evdev force feedback; nothing happens where there is none"""
    fd, ids = None, {}

    def play(self, ms):
        try:
            if self.fd is None:
                self.fd = -1
                for d in glob.glob("/sys/class/input/event*"):
                    with open(d + "/device/name") as f:
                        if "haptic" in f.read().lower():
                            self.fd = os.open("/dev/input/" + os.path.basename(d), os.O_RDWR | os.O_NONBLOCK)
            if self.fd < 0:
                return
            if ms not in self.ids:  # struct ff_effect: FF_RUMBLE, new id, replay length, strong magnitude
                e = bytearray(struct.pack("HhHHHHH2xHH28x", 0x50, -1, 0, 0, 0, ms, 0, 0xc000, 0))
                fcntl.ioctl(self.fd, 0x40304580, e)  # EVIOCSFF
                self.ids[ms] = struct.unpack_from("h", e, 2)[0]
            os.write(self.fd, struct.pack("qqHHi", 0, 0, 0x15, self.ids[ms], 1))  # EV_FF: play
        except OSError:
            self.fd = -1


